@code {
    private List<CustomThemeModel> presetThemes = new();
    private List<CustomThemeModel> savedThemes = new();
    private CustomThemeModel currentTheme = new();
    private string customPaletteName = "";
    private bool showAdvanced = false;
    private bool isSaving = false;
    private bool showPopupModal = false;
    private string popupMessage = "";
    private bool isSuccess = true;

    protected override async Task OnInitializedAsync()
    {
        presetThemes = ThemeSvc.GetPresetThemes();
        savedThemes = await ThemeSvc.GetSavedCustomThemesAsync();
        currentTheme = await ThemeSvc.GetCurrentThemeAsync();
    }

    private void ShowPopup(string message, bool success = true)
    {
        popupMessage = message;
        isSuccess = success;
        showPopupModal = true;
        StateHasChanged();
    }

    private void ClosePopup()
    {
        showPopupModal = false;
        StateHasChanged();
    }

    private async Task SelectPreset(CustomThemeModel preset)
    {
        currentTheme = new CustomThemeModel
        {
            Rank = preset.Rank,
            PresetName = preset.PresetName,
            PrimaryColor = preset.PrimaryColor,
            HoverColor = preset.HoverColor,
            ActiveColor = preset.ActiveColor,
            AccentColor = preset.AccentColor,
            TextColor = preset.TextColor,
            SurfaceColor = preset.SurfaceColor,
            BadgeColor = preset.BadgeColor,
            BorderColor = preset.BorderColor,
            TextOnPrimary = preset.TextOnPrimary,
            Character = preset.Character
        };

        await ThemeSvc.ApplyThemeAsync(currentTheme);
        StateHasChanged();
    }

    private async Task OnPrimaryColorPickerChanged(ChangeEventArgs e)
    {
        var hex = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(hex))
        {
            var name = string.IsNullOrWhiteSpace(customPaletteName) ? "Custom Palette" : customPaletteName;
            currentTheme = CustomThemeModel.CreateFromPrimary(hex, name);
            await ThemeSvc.ApplyThemeAsync(currentTheme);
            StateHasChanged();
        }
    }

    private async Task OnPrimaryHexInputChanged(ChangeEventArgs e)
    {
        var hex = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(hex) && (hex.Length == 6 || hex.Length == 7))
        {
            var name = string.IsNullOrWhiteSpace(customPaletteName) ? "Custom Palette" : customPaletteName;
            currentTheme = CustomThemeModel.CreateFromPrimary(hex, name);
            await ThemeSvc.ApplyThemeAsync(currentTheme);
            StateHasChanged();
        }
    }

    private async Task RecomputeFromPrimary()
    {
        var name = string.IsNullOrWhiteSpace(customPaletteName) ? (string.IsNullOrWhiteSpace(currentTheme.PresetName) ? "Custom Palette" : currentTheme.PresetName) : customPaletteName;
        currentTheme = CustomThemeModel.CreateFromPrimary(currentTheme.PrimaryColor, name);
        await ThemeSvc.ApplyThemeAsync(currentTheme);
        StateHasChanged();
    }

    private async Task OnAdvancedColorChanged()
    {
        if (string.IsNullOrWhiteSpace(currentTheme.PresetName) || currentTheme.PresetName == "Default")
        {
            currentTheme.PresetName = "Custom Palette";
        }
        await ThemeSvc.ApplyThemeAsync(currentTheme);
        StateHasChanged();
    }

    private async Task SaveCustomPalette()
    {
        isSaving = true;
        try
        {
            var name = string.IsNullOrWhiteSpace(customPaletteName) 
                ? (string.IsNullOrWhiteSpace(currentTheme.PresetName) || currentTheme.PresetName == "Custom" ? $"Palette ({currentTheme.PrimaryColor})" : currentTheme.PresetName)
                : customPaletteName;

            var toSave = new CustomThemeModel
            {
                Rank = "🎨",
                PresetName = name,
                PrimaryColor = currentTheme.PrimaryColor,
                HoverColor = currentTheme.HoverColor,
                ActiveColor = currentTheme.ActiveColor,
                AccentColor = currentTheme.AccentColor,
                TextColor = currentTheme.TextColor,
                SurfaceColor = currentTheme.SurfaceColor,
                BadgeColor = currentTheme.BadgeColor,
                BorderColor = currentTheme.BorderColor,
                TextOnPrimary = currentTheme.TextOnPrimary,
                Character = "Saved Custom Color"
            };

            var success = await ThemeSvc.AddSavedCustomThemeAsync(toSave);
            if (success)
            {
                savedThemes = await ThemeSvc.GetSavedCustomThemesAsync();
                currentTheme.PresetName = name;
                await ThemeSvc.SaveThemeAsync(currentTheme);
                customPaletteName = "";
                ShowPopup($"Palette \"{name}\" has been saved to your custom colors library!", true);
            }
            else
            {
                ShowPopup("Failed to save palette to storage.", false);
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Error: {ex.Message}", false);
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private async Task DeleteCustomPalette(CustomThemeModel theme)
    {
        try
        {
            await ThemeSvc.DeleteSavedCustomThemeAsync(theme.PresetName);
            savedThemes = await ThemeSvc.GetSavedCustomThemesAsync();
            ShowPopup($"Palette \"{theme.PresetName}\" was removed from your saved colors.", true);
        }
        catch (Exception ex)
        {
            ShowPopup($"Error deleting palette: {ex.Message}", false);
        }
        StateHasChanged();
    }

    private async Task SaveCurrentTheme()
    {
        isSaving = true;
        try
        {
            var success = await ThemeSvc.SaveThemeAsync(currentTheme);
            if (success)
            {
                ShowPopup($"Theme \"{currentTheme.PresetName}\" has been applied and saved successfully!", true);
            }
            else
            {
                ShowPopup("Failed to save theme settings.", false);
            }
        }
        catch (Exception ex)
        {
            ShowPopup($"Error: {ex.Message}", false);
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private async Task ResetToDefault()
    {
        isSaving = true;
        try
        {
            await ThemeSvc.ResetToDefaultAsync();
            currentTheme = await ThemeSvc.GetCurrentThemeAsync();
            ShowPopup("Theme has been reset to Vibrant Orange (Default).", true);
        }
        catch (Exception ex)
        {
            ShowPopup($"Error resetting theme: {ex.Message}", false);
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }
}
