    private async Task ConfirmStockTransfer()
    {
        if (!CanAddStockTransfer)
        {
            notificationMessage = LangSvc.GetText("NoPermissionToAddStockTransfer");
            notificationType = "warning";
            isNotificationVisible = true;
            return;
        }

        if (string.IsNullOrEmpty(selectedFromBranchID))
        {
            notificationMessage = "Please select an Origin Branch.";
            notificationType = "warning";
            isNotificationVisible = true;
            return;
        }
        if (string.IsNullOrEmpty(selectedToBranchID))
        {
            notificationMessage = "Please select a Destination Branch.";
            notificationType = "warning";
            isNotificationVisible = true;
            return;
        }
        if (selectedFromBranchID == selectedToBranchID)
        {
            notificationMessage = "Origin and Destination branches cannot be the same.";
            notificationType = "warning";
            isNotificationVisible = true;
            return;
        }
        if (!stockInItems.Any(i => i.StockInQuantity > 0))
        {
            notificationMessage = LangSvc.GetText("InventoryErrorAddAtLeastOne");
            notificationType = "warning";
            isNotificationVisible = true;
            return;
        }

        var request = new EBI.UC.Doc_StockTransfer();

        var fromBranchObj = branches.FirstOrDefault(b => b.BranchID == selectedFromBranchID);
        var fromBranchName = fromBranchObj?.Branch ?? selectedFromBranchName;
        if (string.IsNullOrEmpty(fromBranchName)) fromBranchName = selectedFromBranchID;

        var toBranchObj = branches.FirstOrDefault(b => b.BranchID == selectedToBranchID);
        var toBranchName = toBranchObj?.Branch ?? selectedToBranchName;
        if (string.IsNullOrEmpty(toBranchName)) toBranchName = selectedToBranchID;

        request.objDoc_StockTransfer.BranchID = selectedFromBranchID; // The originating branch
        request.objDoc_StockTransfer.FromBranchID = selectedFromBranchID;
        request.objDoc_StockTransfer.FromBranch = fromBranchName;
        request.objDoc_StockTransfer.ToBranchID = selectedToBranchID;
        request.objDoc_StockTransfer.ToBranch = toBranchName;
        request.objDoc_StockTransfer.FinancialDate = isEditing && editingFinancialDate.HasValue
            ? editingFinancialDate.Value
            : DateTime.Now;
        request.objDoc_StockTransfer.Remarks = remarks;

        if (isEditing)
        {
            request.objDoc_StockTransfer.DocumentID = editingDocNumber;
            request.objDoc_StockTransfer.SaveAction = EBI.Enum.EntityState.Changed;
            request.objDoc_StockTransfer.IsDirty = true;
        }
        else
        {
            request.objDoc_StockTransfer.SaveAction = EBI.Enum.EntityState.Added;
        }

        foreach (var item in stockInItems.Where(i => i.StockInQuantity > 0))
        {
            InventoryDM masterInventoryItem = allItemsList.FirstOrDefault(i => i.MasterAccountID == item.Id);

            var lineItem = new EBI.DM.DocumentLineTableDM();
            lineItem.Description = masterInventoryItem?.AccountName ?? item.Name;
            lineItem.InventoryTypeID = masterInventoryItem?.InventoryTypeID ?? 1;
            lineItem.InventoryItemAccountID = masterInventoryItem?.MasterAccountID ?? item.Id;
            lineItem.LineItemID = masterInventoryItem?.MasterAccountID ?? item.Id;
            lineItem.Quantity = item.StockInQuantity;
            lineItem.UnitPrice = item.StockInCost;
            
            // Fill UnitOfMeasurementID and SKUQuantity according to inventory item specifications
            lineItem.UnitOfMeasurementID = masterInventoryItem?.UnitOfMeasureID;
            var uomBase = masterInventoryItem?.UOMBase ?? 0;
            lineItem.SKUQuantity = uomBase == 0 ? 1 : uomBase;

            lineItem.SaveAction = EBI.Enum.EntityState.Added;

            request.lstDocumentLine.Add(lineItem);
        }

        try
        {
            var jsonOptions = new System.Text.Json.JsonSerializerOptions { WriteIndented = true };
            var requestJson = System.Text.Json.JsonSerializer.Serialize(request, jsonOptions);
            System.Diagnostics.Debug.WriteLine($"[ConfirmStockTransfer] Stock Transfer Request Body:\n{requestJson}");
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[ConfirmStockTransfer] Error serializing Transfer request: {ex.Message}");
        }

        StockTransferSaveResult saveResult;
        if (isEditing)
        {
            saveResult = await InventoryService.UpdateStockTransfer(request);
        }
        else
        {
            saveResult = await InventoryService.CreateStockTransfer(request);
        }

        if (saveResult.TransferSaved)
        {
            // Add to session history
            var localItems = stockInItems.Where(i => i.StockInQuantity > 0).Select(i => new StockTransferHistoryItem
            {
                Id = i.Id,
                ProductName = i.Name,
                Quantity = i.StockInQuantity,
                Cost = i.StockInCost
            }).ToList();

            if (isEditing)
            {
                stockTransferHistory.RemoveAll(h => h.DocNumber == editingDocNumber);
            }

            var newEntry = new StockTransferHistoryEntry
            {
                DocNumber = saveResult.TransferDocumentId
                    ?? (isEditing ? editingDocNumber : "Transfer created"),
                Date = DateTime.Now,
                Remarks = remarks,
                FromBranch = selectedFromBranchName,
                ToBranch = selectedToBranchName,
                Items = localItems,
                TotalQuantity = localItems.Sum(i => i.Quantity),
                TotalCost = localItems.Sum(i => (decimal)i.Quantity * i.Cost)
            };
            stockTransferHistory.Insert(0, newEntry);
            
            notificationMessage = string.IsNullOrWhiteSpace(saveResult.Message)
                ? (isEditing ? "Stock transfer updated successfully." : "Stock transfer created successfully.")
                : saveResult.Message;
            notificationType = "success";
            isNotificationVisible = true;

            // Stock Transfer is its own document flow. GIN belongs to Stock Out and GRN belongs to Stock In.
            stockInItems.Clear();
            remarks = "";
            isEditing = false;
            editingDocNumber = "";
            editingFinancialDate = null;

            await OnConfirm.InvokeAsync();
        }
        else
        {
            notificationMessage = string.IsNullOrWhiteSpace(saveResult.Message)
                ? (isEditing ? "Failed to update stock transfer." : "Failed to create stock transfer.")
                : saveResult.Message;
            notificationType = "danger";
            isNotificationVisible = true;
        }
    }

