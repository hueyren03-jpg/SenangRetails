    private async Task LoadHistoryFromApiAsync()
    {
        if (historyStartDate.Date > historyEndDate.Date)
        {
            notificationMessage = LangSvc.GetText("StartDateCannotExceedEndDate");
            notificationType = "danger";
            isNotificationVisible = true;
            StateHasChanged();
            return;
        }
        try
        {
            var records = await InventoryService.GetAllStockTransferRecordAsync(historyStartDate, historyEndDate, 1, 50);

            try
            {
                var json = System.Text.Json.JsonSerializer.Serialize(records, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
                System.Diagnostics.Debug.WriteLine($"[IncomingStockTransfer] LoadHistoryFromApiAsync - Count: {records?.Count ?? 0}\nData:\n{json}");
            }
            catch (Exception jsonEx)
            {
                System.Diagnostics.Debug.WriteLine($"[IncomingStockTransfer] LoadHistoryFromApiAsync - Error serializing records: {jsonEx.Message}");
            }

            doc_StockTransferForEdit = records;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[IncomingStockTransfer] Error loading history from API: {ex.Message}");
        }
    }

    private async Task EditHistoryEntry(EBI.UC.Doc_StockTransfer entry)
    {
        if (!CanEditStockTransfer)
        {
            notificationMessage = LangSvc.GetText("NoPermissionToEditStockTransfer");
            notificationType = "warning";
            isNotificationVisible = true;
            return;
        }

        isHistoryModalOpen = false;
        isEditing = true;

        var fullEntry = await InventoryService.GetStockTransferRecordAsync(entry.objDoc_StockTransfer.DocumentID);
        if (fullEntry != null)
        {
            entry = fullEntry;
        }

        editingDocNumber = entry.objDoc_StockTransfer.DocumentID;
        editingFinancialDate = entry.objDoc_StockTransfer.FinancialDate;
        remarks = entry.objDoc_StockTransfer.Remarks;

        // Find from branch details
        var fromB = branches.FirstOrDefault(b => b.Branch == entry.objDoc_StockTransfer.FromBranch || b.BranchID == entry.objDoc_StockTransfer.FromBranch);
        selectedFromBranchID = fromB?.BranchID ?? entry.objDoc_StockTransfer.FromBranchID;
        selectedFromBranchName = fromB?.Branch ?? entry.objDoc_StockTransfer.FromBranch;

        // Find to branch details
        var toB = branches.FirstOrDefault(b => b.Branch == entry.objDoc_StockTransfer.ToBranch || b.BranchID == entry.objDoc_StockTransfer.ToBranch);
        selectedToBranchID = toB?.BranchID ?? entry.objDoc_StockTransfer.ToBranchID;
        selectedToBranchName = toB?.Branch ?? entry.objDoc_StockTransfer.ToBranch;

        stockInItems.Clear();
        foreach (var item in entry.lstDocumentLine)
        {
            var matched = allAvailableItems.FirstOrDefault(i => i.Id == item.InventoryItemAccountID);
            stockInItems.Add(new InventoryStockIn.StockInItemDisplay
            {
                Id = item.InventoryItemAccountID,
                Name = item.Description,
                CurrentStock = matched?.CurrentStock ?? 0,
                Unit = matched?.Unit ?? "Unit",
                PurchasePrice = matched?.PurchasePrice ?? item.UnitPrice,
                ImagePath = matched?.ImagePath,
                ImageFileName = matched?.ImageFileName,
                StockInQuantity = item.Quantity,
                StockInCost = item.UnitPrice
            });
        }
        StateHasChanged();
    }

    private void CancelEdit()
    {
        isEditing = false;
        editingDocNumber = "";
        editingFinancialDate = null;
        remarks = "";
        selectedFromBranchID = "";
        selectedFromBranchName = "";
        selectedToBranchID = AppState.CurrentBranch?.BranchID ?? "";
        selectedToBranchName = AppState.CurrentBranch?.Branch ?? "";
        stockInItems.Clear();
        StateHasChanged();
    }

    private async Task ConfirmDeleteStockTransfer(EBI.UC.Doc_StockTransfer entry)
    {
        if (!CanDeleteStockTransfer)
        {
            notificationMessage = LangSvc.GetText("NoPermissionToDeleteStockTransfer");
            notificationType = "warning";
            isNotificationVisible = true;
            return;
        }

        var docId = entry.objDoc_StockTransfer.DocumentID;
        var confirmMsg = $"{LangSvc.GetText("ProductDeleteConfirmMsg") ?? "Are you sure you want to delete"} {docId}?";
        bool confirmed = await JS.InvokeAsync<bool>("confirm", confirmMsg);
        if (confirmed)
        {
            try
            {
                var response = await InventoryService.DeleteStockTransferAsync(docId);
                if (response != null && response.statusCode == 200)
                {
                    notificationMessage = response.message ?? "Stock Transfer deleted successfully.";
                    notificationType = "success";
                    isNotificationVisible = true;
                    await LoadHistoryFromApiAsync();
                }
                else
                {
                    notificationMessage = response?.message ?? "Failed to delete Stock Transfer.";
                    notificationType = "danger";
                    isNotificationVisible = true;
                }
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"[IncomingStockTransfer] Error deleting entry: {ex.Message}");
                notificationMessage = $"Error: {ex.Message}";
                notificationType = "danger";
                isNotificationVisible = true;
            }
            finally
            {
                StateHasChanged();
            }
        }
    }

    public void AddProductToStockIn(string masterAccountId)
    {
        var existing = stockInItems.FirstOrDefault(i => i.Id == masterAccountId);
        if (existing != null)
        {
            existing.StockInQuantity++;
        }
        else
        {
            var matched = allAvailableItems.FirstOrDefault(i => i.Id == masterAccountId);
            if (matched != null)
            {
                stockInItems.Add(new InventoryStockIn.StockInItemDisplay
                {
                    Id = matched.Id,
                    Name = matched.Name,
                    CurrentStock = matched.CurrentStock,
                    Unit = matched.Unit,
                    PurchasePrice = matched.PurchasePrice,
                    ImagePath = matched.ImagePath,
                    ImageFileName = matched.ImageFileName,
                    StockInQuantity = 1,
                    StockInCost = matched.PurchasePrice
                });
            }
        }
        StateHasChanged();
    }

