@page "/item-department"
@page "/itemdepartment"
@inherits SenangRetails.Shared.Pages.BasePage
@using SenangRetails.Shared.Models.DTOs
@using SenangRetails.Shared.Services.ItemDepartmentService
@using SenangRetails.Shared.Services.ItemDivisionService
@inject IItemDepartmentService ItemDepartmentService
@inject IItemDivisionService ItemDivisionService
@inject NavigationManager Navigation

<div class="section-container item-department-page">

    <!-- Header -->
    <div class="section-header">
        <div class="header-left">
            <div class="header-nav-row">
                @if (ShowRestoreButton)
                {
                    <button type="button" class="mobile-menu-btn" @onclick="TriggerToggleSidebar" title="Toggle Menu">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                }
                <button type="button" class="back-button" @onclick="GoBack">
                    <i class="fa-solid fa-chevron-left"></i>
                    <span>@LangSvc.GetText("MenuBack")</span>
                </button>
            </div>
            <h2>Item Department</h2>
            <p>Manage product departments and assign them to item divisions</p>
        </div>
        <div class="header-right">
            <button type="button" class="add-btn" @onclick="OpenAddModal">
                <i class="fa-solid fa-plus"></i>
                <span>Add Department</span>
            </button>
        </div>
    </div>

    <!-- Toast Notification -->
    @if (!string.IsNullOrEmpty(notificationMessage))
    {
        <div class="@ToastClass" role="alert">
            <i class="fa-solid @ToastIcon"></i>
            <span>@notificationMessage</span>
            <button type="button" class="alert-close-btn" @onclick='() => notificationMessage = ""'>✕</button>
        </div>
    }

    <!-- List Card -->
    <div class="point-section">
        <div class="section-title-row-with-action">
            <h3>Departments</h3>
            <span class="rule-count-text">@FilteredDepartments.Count() department(s)</span>
        </div>

        <!-- Search & Filter -->
        <div class="search-toolbar-row">
            <div class="staff-search-wrap">
                <i class="fa-solid fa-magnifying-glass staff-search-icon"></i>
                <input type="text"
                       class="staff-search-input"
                       placeholder="Search department code, name or division..."
                       @bind="searchQuery"
                       @bind:event="oninput" />
                @if (!string.IsNullOrEmpty(searchQuery))
                {
                    <button type="button" class="search-clear-btn" @onclick='() => searchQuery = ""'>✕</button>
                }
            </div>

            <div class="filter-controls-wrap">
                <!-- Division Filter Dropdown -->
                <select class="division-filter-select" @bind="divisionFilter">
                    <option value="">All Divisions</option>
                    @foreach (var div in divisions)
                    {
                        <option value="@div.Id">@div.Name</option>
                    }
                </select>

                <!-- Status Filter Pills -->
                <div class="filter-pills-wrap">
                    <button type="button" class="@PillClass("All")" @onclick='() => statusFilter = "All"'>
                        All (@departments.Count)
                    </button>
                    <button type="button" class="@PillClass("Active")" @onclick='() => statusFilter = "Active"'>
                        Active (@departments.Count(d => d.Active))
                    </button>
                    <button type="button" class="@PillClass("Inactive")" @onclick='() => statusFilter = "Inactive"'>
                        Inactive (@departments.Count(d => !d.Active))
                    </button>
                </div>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="loading-state">
                <div class="loading-spinner"></div>
                <span>Loading item departments...</span>
            </div>
        }
        else if (!FilteredDepartments.Any())
        {
            <div class="empty-state">
                <div class="empty-icon-wrap">
                    <i class="fa-solid fa-building"></i>
                </div>
                <h4>No item departments found</h4>
                @if (!string.IsNullOrEmpty(searchQuery) || statusFilter != "All" || !string.IsNullOrEmpty(divisionFilter))
                {
                    <p>No results match your search or filter criteria.</p>
                    <button type="button" class="btn-clear-filters" @onclick="ClearFilters">Clear Filters</button>
                }
                else
                {
                    <p>Organize your products by adding your first department.</p>
                    <button type="button" class="add-btn empty-action-btn" @onclick="OpenAddModal">
                        <i class="fa-solid fa-plus"></i> Add Department
                    </button>
                }
            </div>
        }
        else
        {
            <div class="list-container">
                <div class="list-header">
                    <span class="align-left sortable-cell" @onclick='() => SortBy("Code")'>
                        Department Code
                        @if (sortColumn == "Code") { <span class="sort-caret">@(sortAscending ? "▲" : "▼")</span> }
                    </span>
                    <span class="align-left sortable-cell" @onclick='() => SortBy("Name")'>
                        Department Name
                        @if (sortColumn == "Name") { <span class="sort-caret">@(sortAscending ? "▲" : "▼")</span> }
                    </span>
                    <span class="align-left sortable-cell" @onclick='() => SortBy("Division")'>
                        Division
                        @if (sortColumn == "Division") { <span class="sort-caret">@(sortAscending ? "▲" : "▼")</span> }
                    </span>
                    <span class="align-center sortable-cell" @onclick='() => SortBy("Active")'>
                        Active
                        @if (sortColumn == "Active") { <span class="sort-caret">@(sortAscending ? "▲" : "▼")</span> }
                    </span>
                    <span class="align-center">Actions</span>
                </div>

                @foreach (var item in FilteredDepartments)
                {
                    <div class="@RowClass(item)" @onclick="() => OpenEditModal(item)">

                        <span class="cell align-left" data-label="Department Code">
                            <span class="dept-code-badge">@item.Code</span>
                        </span>

                        <span class="cell align-left" data-label="Department Name">
                            <span class="dept-desc-text">@item.Name</span>
                        </span>

                        <span class="cell align-left" data-label="Division">
                            @if (!string.IsNullOrWhiteSpace(item.DivisionName))
                            {
                                <span class="division-tag">
                                    <i class="fa-solid fa-sitemap tag-icon"></i>
                                    @item.DivisionName
                                </span>
                            }
                            else
                            {
                                <span class="no-division-tag">—</span>
                            }
                        </span>

                        <span class="cell align-center" data-label="Active" @onclick:stopPropagation>
                            <div class="active-cell-wrap">
                                <div class="@TickClass(item.Active)" @onclick="() => ToggleItemActive(item)" title="Toggle active">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                </div>
                                <span class="@BadgeClass(item.Active)">@(item.Active ? "Active" : "Inactive")</span>
                            </div>
                        </span>

                        <span class="cell align-center" data-label="Actions" @onclick:stopPropagation>
                            <div class="action-buttons-wrap">
                                <button type="button" class="pt-action-btn" title="Edit" @onclick="() => OpenEditModal(item)">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </button>
                                <button type="button" class="pt-action-btn pt-delete-btn" title="Delete" @onclick="() => RequestDelete(item)">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>
                        </span>

                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Add / Edit Modal -->
@if (showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="department-modal-box" @onclick:stopPropagation>

            <div class="modal-header">
                <div class="modal-title-wrap">
                    <div class="modal-icon-badge">
                        <i class="fa-solid fa-building"></i>
                    </div>
                    <h3>@(isEditing ? "Edit Department" : "Add Department")</h3>
                </div>
                <button type="button" class="modal-close-btn" @onclick="CloseModal" aria-label="Close">✕</button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(formError))
                {
                    <div class="form-error-banner">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span>@formError</span>
                    </div>
                }

                @if (isEditing && !string.IsNullOrEmpty(currentModel.Code))
                {
                    <div class="form-group">
                        <label class="form-label">Department ID</label>
                        <input type="text" class="form-control locked-control" value="@currentModel.Code" readonly disabled />
                    </div>
                }

                <div class="form-group">
                    <label class="form-label" for="deptName">Department Name <span class="required">*</span></label>
                    <input type="text"
                           id="deptName"
                           class="form-control"
                           placeholder="Enter department name"
                           maxlength="255"
                           @bind="currentModel.Name" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="deptDivision">Division</label>
                    <select id="deptDivision" class="form-control" @bind="currentModel.DivisionId">
                        <option value="">-- None --</option>
                        @foreach (var div in divisions)
                        {
                            <option value="@div.Id">@div.Name</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <div class="active-toggle-row" @onclick="ToggleFormActive">
                        <div class="@FormTickClass">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        </div>
                        <div class="checkbox-label-text">
                            <span class="label-primary">Active</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-cancel" @onclick="CloseModal" disabled="@isSaving">Cancel</button>
                <button type="button" class="btn-save" @onclick="SaveDepartment" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-inline"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (showDeleteConfirm && itemToDelete != null)
{
    <div class="modal-overlay" @onclick="CancelDelete">
        <div class="department-modal-box confirm-modal-box" @onclick:stopPropagation>

            <div class="modal-header confirm-header">
                <div class="delete-icon-badge">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <h3>Delete Department</h3>
            </div>

            <div class="modal-body confirm-body">
                <p>Are you sure you want to delete this department?</p>
                <div class="delete-item-preview">
                    <span class="dept-code-badge">@itemToDelete.Code</span>
                    <strong>@itemToDelete.Name</strong>
                    @if (!string.IsNullOrWhiteSpace(itemToDelete.DivisionName))
                    {
                        <span class="division-tag" style="margin-left: 6px;">@itemToDelete.DivisionName</span>
                    }
                </div>
                <p class="warning-note">This action cannot be undone.</p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-cancel" @onclick="CancelDelete" disabled="@isDeleting">Cancel</button>
                <button type="button" class="btn-delete-confirm" @onclick="ConfirmDelete" disabled="@isDeleting">
                    @if (isDeleting)
                    {
                        <span class="spinner-inline"></span>
                        <span>Deleting...</span>
                    }
                    else
                    {
                        <span>Delete</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnToggleSidebar { get; set; }
    [Parameter] public bool ShowRestoreButton { get; set; } = false;

    private List<ItemDepartmentModel> departments = new();
    private List<ItemDivisionModel> divisions = new();
    private bool isLoading = true;
    private string searchQuery = "";
    private string statusFilter = "All";
    private string divisionFilter = "";
    private string sortColumn = "Code";
    private bool sortAscending = true;

    private bool showModal = false;
    private bool isEditing = false;
    private ItemDepartmentModel currentModel = new();
    private string formError = "";
    private bool isSaving = false;

    private bool showDeleteConfirm = false;
    private ItemDepartmentModel? itemToDelete = null;
    private bool isDeleting = false;

    private string notificationMessage = "";
    private string notificationType = "success";

    // ── CSS helpers ──────────────────────────────────────────────────────────
    private string PillClass(string filter) =>
        statusFilter == filter ? "filter-pill active" : "filter-pill";

    private string RowClass(ItemDepartmentModel item) =>
        item.Active ? "list-item" : "list-item item-inactive";

    private string TickClass(bool active) =>
        active ? "custom-tick-checkbox checked" : "custom-tick-checkbox";

    private string BadgeClass(bool active) =>
        active ? "status-badge badge-active" : "status-badge badge-inactive";

    private string FormTickClass =>
        currentModel.Active ? "custom-tick-checkbox checked" : "custom-tick-checkbox";

    private string ToastClass =>
        notificationType == "error" ? "alert-toast alert-error" : "alert-toast alert-success";

    private string ToastIcon =>
        notificationType == "error" ? "fa-circle-exclamation" : "fa-circle-check";

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            var divisionsTask = ItemDivisionService.GetDivisionsAsync();
            var departmentsTask = ItemDepartmentService.GetDepartmentsAsync();

            await Task.WhenAll(divisionsTask, departmentsTask);

            divisions = divisionsTask.Result ?? new();
            departments = departmentsTask.Result ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ItemDepartment] Error: {ex.Message}");
            departments = new();
            ShowNotification("Failed to load item departments.", isError: true);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private IEnumerable<ItemDepartmentModel> FilteredDepartments
    {
        get
        {
            var query = departments.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var q = searchQuery.Trim();
                query = query.Where(d =>
                    (d.Code?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (d.Name?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (d.DivisionName?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            if (!string.IsNullOrWhiteSpace(divisionFilter))
            {
                query = query.Where(d => string.Equals(d.DivisionId, divisionFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (statusFilter == "Active")
                query = query.Where(d => d.Active);
            else if (statusFilter == "Inactive")
                query = query.Where(d => !d.Active);

            return sortColumn switch
            {
                "Name" => sortAscending
                    ? query.OrderBy(d => d.Name).ThenBy(d => d.Code)
                    : query.OrderByDescending(d => d.Name).ThenBy(d => d.Code),
                "Division" => sortAscending
                    ? query.OrderBy(d => d.DivisionName).ThenBy(d => d.Code)
                    : query.OrderByDescending(d => d.DivisionName).ThenBy(d => d.Code),
                "Active" => sortAscending
                    ? query.OrderBy(d => d.Active).ThenBy(d => d.Name)
                    : query.OrderByDescending(d => d.Active).ThenBy(d => d.Name),
                _ => sortAscending
                    ? query.OrderBy(d => d.Code)
                    : query.OrderByDescending(d => d.Code)
            };
        }
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else { sortColumn = column; sortAscending = true; }
    }

    private void ClearFilters() { searchQuery = ""; statusFilter = "All"; divisionFilter = ""; }

    private void OpenAddModal()
    {
        isEditing = false;
        formError = "";
        currentModel = new ItemDepartmentModel { Id = "", Code = "", Name = "", DivisionId = "", Active = true };
        showModal = true;
    }

    private void OpenEditModal(ItemDepartmentModel item)
    {
        isEditing = true;
        formError = "";
        currentModel = new ItemDepartmentModel
        {
            Id = item.Id,
            Code = item.Code,
            Name = item.Name,
            DivisionId = item.DivisionId,
            DivisionName = item.DivisionName,
            Active = item.Active,
            Sequence = item.Sequence,
            CreatedDateTime = item.CreatedDateTime
        };
        showModal = true;
    }

    private void CloseModal()
    {
        if (isSaving) return;
        showModal = false;
        formError = "";
    }

    private void ToggleFormActive() => currentModel.Active = !currentModel.Active;

    private async Task ToggleItemActive(ItemDepartmentModel item)
    {
        item.Active = !item.Active;
        var (success, _) = await ItemDepartmentService.SaveDepartmentAsync(item);
        if (success)
            ShowNotification($"'{item.Name}' is now {(item.Active ? "Active" : "Inactive")}.");
        else
        {
            item.Active = !item.Active;
            ShowNotification("Failed to update status.", isError: true);
        }
        StateHasChanged();
    }

    private async Task SaveDepartment()
    {
        formError = "";

        if (string.IsNullOrWhiteSpace(currentModel.Name))
        {
            formError = "Department Name is required.";
            return;
        }

        var duplicate = departments.FirstOrDefault(d =>
            d.Id != currentModel.Id &&
            d.Name.Equals(currentModel.Name.Trim(), StringComparison.OrdinalIgnoreCase) &&
            string.Equals(d.DivisionId, currentModel.DivisionId ?? "", StringComparison.OrdinalIgnoreCase));
        if (duplicate != null)
        {
            formError = $"Department '{currentModel.Name.Trim()}' already exists in this division.";
            return;
        }

        isSaving = true;
        try
        {
            currentModel.Name = currentModel.Name.Trim();

            var (success, message) = await ItemDepartmentService.SaveDepartmentAsync(currentModel);
            if (success)
            {
                showModal = false;
                await LoadDataAsync();
                ShowNotification(isEditing ? $"Updated '{currentModel.Name}'." : $"Added '{currentModel.Name}'.");
            }
            else
            {
                formError = string.IsNullOrWhiteSpace(message) ? "Failed to save department." : message;
            }
        }
        catch (Exception ex)
        {
            formError = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void RequestDelete(ItemDepartmentModel item) { itemToDelete = item; showDeleteConfirm = true; }

    private void CancelDelete()
    {
        if (isDeleting) return;
        showDeleteConfirm = false;
        itemToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (itemToDelete == null) return;
        isDeleting = true;
        try
        {
            var (success, message) = await ItemDepartmentService.DeleteDepartmentAsync(itemToDelete.Id);
            if (success)
            {
                showDeleteConfirm = false;
                var code = itemToDelete.Code;
                itemToDelete = null;
                await LoadDataAsync();
                ShowNotification($"Deleted '{code}'.");
            }
            else
            {
                ShowNotification(string.IsNullOrWhiteSpace(message) ? "Failed to delete." : message, isError: true);
            }
        }
        catch (Exception ex) { ShowNotification($"Error: {ex.Message}", isError: true); }
        finally { isDeleting = false; StateHasChanged(); }
    }

    private void ShowNotification(string msg, bool isError = false)
    {
        notificationMessage = msg;
        notificationType = isError ? "error" : "success";
        _ = AutoDismissNotification();
    }

    private async Task AutoDismissNotification()
    {
        await Task.Delay(4000);
        notificationMessage = "";
        await InvokeAsync(StateHasChanged);
    }

    private async Task TriggerToggleSidebar()
    {
        if (OnToggleSidebar.HasDelegate)
            await OnToggleSidebar.InvokeAsync();
    }

    private void GoBack() => Navigation.NavigateTo("/menu");
}
