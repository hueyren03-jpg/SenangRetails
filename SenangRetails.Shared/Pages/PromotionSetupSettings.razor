    private string GeneratePromoCode()
    {
        var nextNumber = 101;
        while (promotions.Any(p => string.Equals(p.Code, $"PROMO-{nextNumber}", StringComparison.OrdinalIgnoreCase)))
        {
            nextNumber++;
        }

        return $"PROMO-{nextNumber}";
    }

    private async Task SavePromo()
    {
        validationAttempted = true;
        errorMessage = "";
        currentPromo.Code = currentPromo.Code?.Trim().ToUpperInvariant() ?? "";
        currentPromo.Name = currentPromo.Name?.Trim() ?? "";
        currentPromo.BranchID = currentPromo.BranchID?.Trim() ?? "";
        if (!string.IsNullOrWhiteSpace(currentPromo.BranchID) &&
            !currentPromo.AvailableBranchIds.Contains(currentPromo.BranchID, StringComparer.OrdinalIgnoreCase))
        {
            currentPromo.AvailableBranchIds.Add(currentPromo.BranchID);
        }
        SyncOptionItemsFromAppliedProducts();

        if (string.IsNullOrWhiteSpace(currentPromo.Code) || string.IsNullOrWhiteSpace(currentPromo.Name))
        {
            errorMessage = string.IsNullOrWhiteSpace(currentPromo.Name)
                ? "Enter an account name before saving."
                : "Enter a display code before saving.";
            return;
        }

        if (!isEditMode && promotions.Any(p => string.Equals(p.Code, currentPromo.Code, StringComparison.OrdinalIgnoreCase)))
        {
            errorMessage = $"Display code {currentPromo.Code} already exists.";
            return;
        }

        if (currentPromo.StartDate.HasValue && currentPromo.EndDate.HasValue && currentPromo.StartDate > currentPromo.EndDate)
        {
            errorMessage = "Available Date To must be on or after Available Date From.";
            return;
        }

        if (currentPromo.AppliedProductIds.Count == 0)
        {
            errorMessage = "Select at least one attached product before saving.";
            activeTab = "AppliedProducts";
            return;
        }

        isSaving = true;
        try
        {
            var isNew = string.IsNullOrWhiteSpace(currentPromo.MasterAccountID);
            EBI.UC.Inventory? aggregate = null;
            if (!isNew)
            {
                apiPromotionRecords.TryGetValue(currentPromo.MasterAccountID, out aggregate);
                aggregate ??= await InventorySvc.LoadFullPackageAsync(currentPromo.MasterAccountID);
            }

            aggregate ??= new EBI.UC.Inventory();
            ApplyFormToApiPromotion(aggregate, currentPromo, isNew);

            var result = isNew
                ? await InventorySvc.CreateItemAsync(aggregate)
                : await InventorySvc.UpdateItemAsync(aggregate);

            if (!result.Success)
            {
                errorMessage = string.IsNullOrWhiteSpace(result.Message)
                    ? "The promotion could not be saved by InventoryFull."
                    : $"The promotion could not be saved: {result.Message}";
                return;
            }

            showModal = false;
            validationAttempted = false;
            await LoadPromotions();
            saveMessage = $"{currentPromo.Name} was saved successfully.";
        }
        catch (Exception ex)
        {
            errorMessage = $"The promotion could not be saved: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ApplyFormToApiPromotion(EBI.UC.Inventory aggregate, PromotionSetupModel form, bool isNew)
    {
        var inventory = aggregate.objInventory;
        inventory.InventoryTypeID = 8;
        inventory.AccountName = form.Name;
        inventory.DisplayCode = form.Code;
        inventory.ProductCode = form.Code;
        inventory.Remarks = form.Remarks;
        inventory.BranchID = form.BranchID;
        inventory.IsSold = form.IsActive;
        inventory.AccountStatus = form.IsActive ? "Active" : "Inactive";
        inventory.AvailableDateFrom = form.StartDate ?? DateTime.MinValue;
        inventory.AvailableDateTo = form.EndDate ?? DateTime.MinValue;
        inventory.AvailableTimeFrom = form.AvailableTimeFrom;
        inventory.AvailableTimeTo = form.AvailableTimeTo;
        inventory.PromoPriority = form.PromoPriority;
        inventory.MaxDiscountLimit = form.MaxDiscountLimit;
        inventory.PromoItemsCount = form.MinQuantity;
        inventory.HasPackage = true;
        inventory.IsDirty = true;
        inventory.SaveAction = isNew ? EBI.Enum.EntityState.Added : EBI.Enum.EntityState.Changed;

        var firstSelectedId = form.AppliedProductIds.First();
        var firstSelectedProduct = FindAttachedItem(firstSelectedId);
        var activeRules = inventory.lstPackage.Where(rule => !rule.IsVoided).ToList();
        var primaryRule = activeRules.FirstOrDefault();

        if (primaryRule == null)
        {
            primaryRule = new Inventory_PackageItemDM
            {
                InventoryID = firstSelectedId,
                Description = firstSelectedProduct?.AccountName ?? firstSelectedId,
                InventoryTypeID = firstSelectedProduct?.InventoryTypeID ?? 0
            };
            inventory.lstPackage.Add(primaryRule);
            activeRules.Add(primaryRule);
        }

        EnsurePackageRuleProduct(primaryRule, form, firstSelectedId, firstSelectedProduct);

        if (IsBuyGetFormRule(form))
        {
            ConfigureBuyGetTriggerRule(
                primaryRule,
                form,
                inventory.MasterAccountID,
                isNew || string.IsNullOrWhiteSpace(primaryRule.AutoID));

            var rewardRule = activeRules
                .Skip(1)
                .FirstOrDefault(rule => rule.PromotionMethod != 0)
                ?? activeRules.Skip(1).FirstOrDefault();
            if (rewardRule == null)
            {
                rewardRule = new Inventory_PackageItemDM
                {
                    InventoryID = firstSelectedId,
                    Description = $"{form.Name} Reward",
                    InventoryTypeID = firstSelectedProduct?.InventoryTypeID ?? 0
                };
                inventory.lstPackage.Add(rewardRule);
                activeRules.Add(rewardRule);
            }

            EnsurePackageRuleProduct(rewardRule, form, firstSelectedId, firstSelectedProduct);
            ApplyFormToPackageRule(
                rewardRule,
                form,
                inventory.MasterAccountID,
                isNew || string.IsNullOrWhiteSpace(rewardRule.AutoID));
            rewardRule.Quantity = 1;
            rewardRule.MaxQuantity = form.MaxLimitPerOrder;

            foreach (var additionalRule in activeRules.Where(rule =>
                         !ReferenceEquals(rule, primaryRule) &&
                         !ReferenceEquals(rule, rewardRule)))
            {
                UpdatePackageRuleSelections(additionalRule, form, inventory.MasterAccountID);
            }
        }
        else
        {
            ApplyFormToPackageRule(
                primaryRule,
                form,
                inventory.MasterAccountID,
                isNew || string.IsNullOrWhiteSpace(primaryRule.AutoID));

            foreach (var additionalRule in activeRules.Skip(1))
                UpdatePackageRuleSelections(additionalRule, form, inventory.MasterAccountID);
        }

        ApplyAvailableBranches(aggregate, form, inventory.MasterAccountID);
    }

    private static bool IsBuyGetFormRule(PromotionSetupModel form) =>
        string.Equals(form.PromoMethod, "Discount %", StringComparison.OrdinalIgnoreCase) &&
        form.DiscountValue >= 100m &&
        form.MinQuantity > 0 &&
        form.MaxLimitPerOrder > 0;

    private static void EnsurePackageRuleProduct(
        Inventory_PackageItemDM rule,
        PromotionSetupModel form,
        string firstSelectedId,
        InventoryDM? firstSelectedProduct)
    {
        if (!string.IsNullOrWhiteSpace(rule.InventoryID) &&
            form.AppliedProductIds.Contains(rule.InventoryID.Trim(), StringComparer.OrdinalIgnoreCase))
        {
            return;
        }

        rule.InventoryID = firstSelectedId;
        rule.Description = firstSelectedProduct?.AccountName ?? firstSelectedId;
        rule.InventoryTypeID = firstSelectedProduct?.InventoryTypeID ?? rule.InventoryTypeID;
    }

    private static void ConfigureBuyGetTriggerRule(
        Inventory_PackageItemDM rule,
        PromotionSetupModel form,
        string? packageId,
        bool isNew)
    {
        rule.PackageID = packageId;
        rule.Quantity = form.MinQuantity;
        rule.PromotionMethod = (int)EBI.Enum.EnumPromotionMethod.NoEffect;
        rule.UnitActualValue = 0;
        rule.MaxQuantity = form.MinQuantity;
        rule.OptionItems = form.OptionItems;
        rule.OptionGroups = form.OptionGroups;
        rule.OptionBrands = form.OptionBrands;
        rule.HeaderCaption = form.HeaderCaption;
        rule.CustomRules = form.CustomRules;
        rule.IsConfirmed = form.IsConfirmed;
        rule.IsDeferred = form.IsDeferred;
        rule.IsVoided = false;
        rule.IsDirty = true;
        rule.SaveAction = isNew
            ? EBI.Enum.EntityState.Added
            : EBI.Enum.EntityState.Changed;
    }

    private static void UpdatePackageRuleSelections(
        Inventory_PackageItemDM rule,
        PromotionSetupModel form,
        string? packageId)
    {
        rule.PackageID = packageId;
        rule.OptionItems = form.OptionItems;
        rule.OptionGroups = form.OptionGroups;
        rule.OptionBrands = form.OptionBrands;
        rule.IsDirty = true;
        rule.SaveAction = string.IsNullOrWhiteSpace(rule.AutoID)
            ? EBI.Enum.EntityState.Added
            : EBI.Enum.EntityState.Changed;
    }

    private void ApplyAvailableBranches(
        EBI.UC.Inventory aggregate,
        PromotionSetupModel form,
        string? masterAccountId)
    {
        var selectedBranchIds = (form.AvailableBranchIds ?? new List<string>())
            .Where(branchId => !string.IsNullOrWhiteSpace(branchId))
            .Select(branchId => branchId.Trim())
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        if (!string.IsNullOrWhiteSpace(form.BranchID))
            selectedBranchIds.Add(form.BranchID.Trim());

        var branchIds = AvailablePromotionBranches
            .Concat(aggregate.lstMasterAccount_Branch
                .Where(branch => !string.IsNullOrWhiteSpace(branch.BranchID))
                .Select(branch => branch.BranchID.Trim()))
            .Concat(selectedBranchIds)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        foreach (var branchId in branchIds)
        {
            var isEnabled = selectedBranchIds.Contains(branchId);
            var existingRows = aggregate.lstMasterAccount_Branch
                .Where(branch => string.Equals(branch.BranchID, branchId, StringComparison.OrdinalIgnoreCase))
                .ToList();

            if (existingRows.Count == 0)
            {
                aggregate.lstMasterAccount_Branch.Add(new MasterAccount_BranchDM
                {
                    MasterAccountTypeID = 4,
                    MasterAccountID = masterAccountId,
                    BranchID = branchId,
                    GroupID = branchId,
                    IsEnabled = isEnabled,
                    SaveAction = EBI.Enum.EntityState.Added,
                    IsDirty = true
                });
                continue;
            }

            foreach (var branch in existingRows)
            {
                if (branch.IsEnabled == isEnabled)
                    continue;

                branch.IsEnabled = isEnabled;
                branch.IsDirty = true;
                branch.SaveAction = string.IsNullOrWhiteSpace(branch.AutoID)
                    ? EBI.Enum.EntityState.Added
                    : EBI.Enum.EntityState.Changed;
            }
        }
    }

