            currentPromo.AvailableBranchIds.Add(branchId);
        else if (!string.Equals(currentPromo.BranchID, branchId, StringComparison.OrdinalIgnoreCase))
            currentPromo.AvailableBranchIds.Remove(existing);
    }

    private static void ApplyFormToPackageRule(
