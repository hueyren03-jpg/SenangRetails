@code {
    private List<PromotionSetupModel> promotions = new();
    private List<InventoryDM> apiPromotions = new();
    private Dictionary<string, EBI.UC.Inventory> apiPromotionRecords = new(StringComparer.OrdinalIgnoreCase);
    private List<InventoryDM> availableProducts = new();
    private InventoryDM? selectedApiPromotion;
    private EBI.UC.Inventory? selectedApiPromotionRecord;
    private bool showApiDetails;
    private string apiLoadError = "";
    private string apiDetailsTab = "General";
    private string selectedApiMethodFilter = "";
    private bool isLoading = true;
    private bool isSaving = false;
    private string searchQuery = "";
    private string selectedTypeFilter = "";

    private bool showModal = false;
    private bool isEditMode = false;
    private string errorMessage = "";
    private string saveMessage = "";
    private bool validationAttempted = false;
    private PromotionSetupModel currentPromo = new();
    private string activeTab = "GeneralSetup";

    private bool showDeleteModal = false;
    private PromotionSetupModel? promoToDelete;

    // Product Picker filters
    private string prodSearchQuery = "";
    private string prodCategoryFilter = "";

    // Keypad State
    private bool showKeypad = false;
    private string keypadTitle = "";
    private string keypadField = "";
    private string keypadValueString = "0";

    private IEnumerable<string> availableCategories =>
        availableProducts
            .Select(p => p.ItemGroupName ?? "")
            .Where(c => !string.IsNullOrEmpty(c))
            .Distinct()
            .OrderBy(c => c);

    private IReadOnlyList<string> AvailablePromotionBranches =>
        (AppState.AvailableBranches ?? new List<string>())
            .Concat(currentPromo.AvailableBranchIds ?? new List<string>())
            .Append(currentPromo.BranchID)
            .Where(branchId => !string.IsNullOrWhiteSpace(branchId))
            .Select(branchId => branchId.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(branchId => branchId)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadPromotions();
    }

    private async Task LoadPromotions()
    {
        isLoading = true;
        apiLoadError = "";
        saveMessage = "";
        try
        {
            var inventory = await InventorySvc.LoadItemsAsync("");
            if (inventory == null)
            {
                promotions = new();
                availableProducts = new();
                apiLoadError = "The Inventory API did not return a response.";
                return;
            }

            availableProducts = inventory
                .Where(item => item.InventoryTypeID != 8)
                .OrderBy(item => item.AccountName)
                .ToList();

            var promotionHeaders = inventory
                .Where(item => item.InventoryTypeID == 8)
                .Where(item => !string.IsNullOrWhiteSpace(item.MasterAccountID))
                .GroupBy(item => item.MasterAccountID, StringComparer.OrdinalIgnoreCase)
                .Select(group => group.First())
                .OrderBy(item => item.AccountName)
                .ToList();

            var loadedPromotions = new List<InventoryDM>();
            var loadedRecords = new Dictionary<string, EBI.UC.Inventory>(StringComparer.OrdinalIgnoreCase);
            foreach (var header in promotionHeaders)
            {
                try
                {
                    var full = await InventorySvc.LoadFullPackageAsync(header.MasterAccountID);
                    if (full != null)
                        loadedRecords[header.MasterAccountID] = full;
                    loadedPromotions.Add(full?.objInventory ?? header);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[PromotionSetup] InventoryFull load failed for {header.MasterAccountID}: {ex.Message}");
                    loadedPromotions.Add(header);
                }
            }

            apiPromotions = loadedPromotions.OrderBy(item => item.AccountName).ToList();
            apiPromotionRecords = loadedRecords;
            promotions = apiPromotions.Select(promotion =>
            {
                loadedRecords.TryGetValue(promotion.MasterAccountID ?? "", out var aggregate);
                return MapApiPromotionToForm(promotion, aggregate);
            }).ToList();
        }
        catch (Exception ex)
        {
            promotions = new();
            apiPromotions = new();
            availableProducts = new();
            apiPromotionRecords = new(StringComparer.OrdinalIgnoreCase);
            apiLoadError = $"Unable to load promotion rules: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<InventoryDM> FilteredApiPromotions
    {
        get
        {
            IEnumerable<InventoryDM> result = apiPromotions;

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var query = searchQuery.Trim();
                result = result.Where(item =>
                    ContainsIgnoreCase(item.AccountName, query) ||
                    ContainsIgnoreCase(item.DisplayCode, query) ||
                    ContainsIgnoreCase(item.MasterAccountID, query) ||
                    ContainsIgnoreCase(item.BranchID, query) ||
                    (item.lstPackage?.Any(rule =>
                        ContainsIgnoreCase(rule.Description, query) ||
                        ContainsIgnoreCase(rule.InventoryID, query) ||
                        ContainsIgnoreCase(rule.AutoID, query)) ?? false));
            }

            if (int.TryParse(selectedApiMethodFilter, out var method))
            {
                result = result.Where(item =>
                    item.lstPackage?.Any(rule => rule.PromotionMethod == method) == true);
            }

            return result;
        }
    }

    private static bool ContainsIgnoreCase(string? value, string query) =>
        value?.Contains(query, StringComparison.OrdinalIgnoreCase) == true;

    private static bool IsApiPromotionActive(InventoryDM promotion) =>
        promotion.IsSold;

    private static string ValueOrDash(object? value)
    {
        var text = value?.ToString()?.Trim();
        return string.IsNullOrWhiteSpace(text) ? "-" : text;
    }

    private static string GetApiPromotionMethodName(int method) => method switch
    {
        0 => "No Effect",
        1 => "Fixed Unit Price",
        2 => "Discount Percentage",
        3 => "Discount Amount",
        4 => "Bundled Discount",
        5 => "Lump Sum Discount",
        6 => "Lump Sum Fixed Price",
        _ => "Unknown Method"
    };

    private static PromotionSetupModel MapApiPromotionToForm(
        InventoryDM promotion,
        EBI.UC.Inventory? aggregate)
    {
        var activeRules = promotion.lstPackage?
            .Where(item => !item.IsVoided)
            .ToList() ?? new List<Inventory_PackageItemDM>();
        var triggerRule = GetBuyGetTriggerRule(activeRules);
        var rule = triggerRule == null
            ? activeRules.FirstOrDefault()
            : activeRules
                .Where(item => !ReferenceEquals(item, triggerRule))
                .FirstOrDefault(item => item.PromotionMethod != 0)
              ?? activeRules.FirstOrDefault(item => !ReferenceEquals(item, triggerRule));
        var appliedProductIds = activeRules
            .SelectMany(GetRuleAppliedProductIds)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        var availableBranchIds = aggregate?.lstMasterAccount_Branch
            .Where(branch => branch.IsEnabled && !string.IsNullOrWhiteSpace(branch.BranchID))
            .Select(branch => branch.BranchID.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(branchId => branchId)
            .ToList() ?? new List<string>();

        if (availableBranchIds.Count == 0 && !string.IsNullOrWhiteSpace(promotion.BranchID))
            availableBranchIds.Add(promotion.BranchID.Trim());

        return new PromotionSetupModel
        {
            MasterAccountID = promotion.MasterAccountID ?? "",
            Code = promotion.DisplayCode ?? "",
            Name = promotion.AccountName ?? "",
            PromoType = rule?.PromotionMethod == 1 ? "Fixed Price" : "Percentage",
            PromoMethod = GetPromotionMethodValue(rule?.PromotionMethod ?? 0),
            Rounding = GetRoundingValue(rule?.RoundingOption ?? 0),
            PromoCondition = GetPromotionConditionValue(rule?.PromoCondition ?? 0),
            DiscountValue = ResolvePromotionFormValue(rule),
            StartDate = promotion.AvailableDateFrom.Year > 1 ? promotion.AvailableDateFrom : null,
            EndDate = promotion.AvailableDateTo.Year > 1 ? promotion.AvailableDateTo : null,
            AvailableTimeFrom = promotion.AvailableTimeFrom,
            AvailableTimeTo = promotion.AvailableTimeTo,
            MinQuantity = Math.Max(1, Convert.ToInt32(triggerRule?.Quantity ?? rule?.Quantity ?? 1)),
            MaxLimitPerOrder = Math.Max(0, Convert.ToInt32(rule?.MaxQuantity ?? 0)),
            IsActive = IsApiPromotionActive(promotion),
            Remarks = promotion.Remarks ?? "",
            BranchID = promotion.BranchID ?? "",
            AvailableBranchIds = availableBranchIds,
            PromoPriority = promotion.PromoPriority,
            MaxDiscountLimit = promotion.MaxDiscountLimit,
            UnitPrice = rule?.UnitPrice ?? 0,
            TotalPrice = rule?.TotalPrice ?? 0,
            TotalActualValue = rule?.TotalActualValue ?? 0,
            PromoConditionAmount = rule?.PromoConditionAmt ?? 0,
            PackageQuantityTypeID = rule?.PackageQuantityTypeID ?? 1,
            IsConfirmed = activeRules.Count == 0 || activeRules.Any(item => item.IsConfirmed),
            IsDeferred = rule?.IsDeferred ?? false,
            OptionItems = string.Join(",", appliedProductIds),
            OptionGroups = rule?.OptionGroups ?? "",
            OptionBrands = rule?.OptionBrands ?? "",
            HeaderCaption = rule?.HeaderCaption ?? "",
            CustomRules = rule?.CustomRules ?? "",
            AppliedProductIds = appliedProductIds
        };
    }

    private static Inventory_PackageItemDM? GetBuyGetTriggerRule(
        IReadOnlyList<Inventory_PackageItemDM> rules)
    {
        if (rules.Count < 2)
            return null;

        var explicitTrigger = rules.FirstOrDefault(rule => rule.PromotionMethod == 0);
        if (explicitTrigger != null)
            return explicitTrigger;

        var firstRule = rules[0];
        var hasRewardRule = rules.Skip(1).Any(rule =>
            rule.MaxQuantity > 0 &&
            rule.PromotionMethod == (int)EBI.Enum.EnumPromotionMethod.DiscountPercentage);
        return firstRule.Quantity > 1 && hasRewardRule ? firstRule : null;
    }

    private static decimal ResolvePromotionFormValue(Inventory_PackageItemDM? rule)
    {
        if (rule == null)
            return 0;
        if (rule.UnitActualValue != 0)
            return rule.UnitActualValue;
        if (rule.PromotionMethod == (int)EBI.Enum.EnumPromotionMethod.DiscountPercentage &&
            rule.UnitPrice > 0 &&
            rule.UnitPrice <= 1)
        {
            return rule.UnitPrice * 100m;
        }

        return rule.UnitPrice;
    }

    private static IReadOnlyList<string> GetRuleAppliedProductIds(Inventory_PackageItemDM rule)
    {
        var optionItems = ParseOptionValues(rule.OptionItems);
        if (optionItems.Count > 0)
            return optionItems;

        return string.IsNullOrWhiteSpace(rule.InventoryID)
            ? Array.Empty<string>()
            : new[] { rule.InventoryID.Trim() };
    }

    private static string GetPromotionMethodValue(int method) => method switch
    {
        0 => "No Effect",
        1 => "Fixed Unit Price",
        2 => "Discount %",
        3 => "Discount Amt",
        4 => "Bundled Discount Amt",
        5 => "Lumpsum Disc Amt",
        6 => "Fixed Lumpsum Price",
        _ => "No Effect"
    };

    private static int GetPromotionMethodId(string? method) => method switch
    {
        "Fixed Unit Price" => 1,
        "Discount %" or "Percentage" => 2,
        "Discount Amt" or "Discount Amount" => 3,
        "Bundled Discount Amt" => 4,
        "Lumpsum Disc Amt" => 5,
        "Fixed Lumpsum Price" => 6,
        _ => 0
    };

    private static string GetPromotionConditionValue(int condition) => condition switch
    {
        1 => "Total Price After Discount, Disc To All Items",
        2 => "Total Price After Discount",
        3 => "Total Quantity Bought, Disc To All Items",
        4 => "Total Quantity Bought",
        5 => "Total Price Before Discount, Disc To All Items",
        6 => "Total Price Before Discount",
        _ => "No Condition"
    };

    private static int GetPromotionConditionId(string? condition) => condition switch
    {
        "Total Price After Discount, Disc To All Items" => 1,
        "Total Price After Discount" => 2,
        "Total Quantity Bought, Disc To All Items" => 3,
        "Total Quantity Bought" => 4,
        "Total Price Before Discount, Disc To All Items" => 5,
        "Total Price Before Discount" => 6,
        _ => 0
    };

    private static string GetRoundingValue(int rounding) => rounding switch
    {
        1 => "Round To5Cent",
        2 => "Round Up To10Cent",
        3 => "Round Up To Dollar",
        4 => "Round Down To10Cent",
        5 => "Round Down To Dollar",
        _ => "No Rounding"
    };

    private static int GetRoundingId(string? rounding) => rounding switch
    {
        "Round To5Cent" => 1,
        "Round Up To10Cent" => 2,
        "Round Up To Dollar" => 3,
        "Round Down To10Cent" => 4,
        "Round Down To Dollar" => 5,
        _ => 0
    };

    private static int GetAttachedItemCount(InventoryDM promotion) =>
        promotion.lstPackage?.Count(rule => !rule.IsVoided) ?? 0;

    private static string FormatDate(DateTime value) =>
        value.Year <= 1 ? "-" : value.ToString("dd/MM/yyyy");

    private static string FormatDateRange(DateTime from, DateTime to)
    {
        var fromText = FormatDate(from);
        var toText = FormatDate(to);
        return fromText == "-" && toText == "-" ? "-" : $"{fromText} - {toText}";
    }

    private static string FormatTime(TimeSpan value) => value.ToString(@"hh\:mm");

    private static string FormatTimeInput(TimeSpan value) => value.ToString(@"hh\:mm\:ss");

    private void OnAvailableTimeFromChanged(ChangeEventArgs args)
    {
        if (TimeOnly.TryParse(args.Value?.ToString(), out var value))
            currentPromo.AvailableTimeFrom = value.ToTimeSpan();
    }

    private void OnAvailableTimeToChanged(ChangeEventArgs args)
    {
        if (TimeOnly.TryParse(args.Value?.ToString(), out var value))
            currentPromo.AvailableTimeTo = value.ToTimeSpan();
    }

    private static string FormatTimeRange(TimeSpan from, TimeSpan to) =>
        $"{FormatTime(from)} - {FormatTime(to)}";

    private InventoryDM? FindAttachedItem(string? inventoryId)
    {
        if (string.IsNullOrWhiteSpace(inventoryId))
            return null;

        return availableProducts.FirstOrDefault(item =>
            string.Equals(item.MasterAccountID, inventoryId, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(item.DisplayCode, inventoryId, StringComparison.OrdinalIgnoreCase));
    }

    private string GetAttachedItemName(string? inventoryId, string? fallbackDescription)
    {
        var item = FindAttachedItem(inventoryId);
        if (!string.IsNullOrWhiteSpace(item?.AccountName))
            return item.AccountName;
        if (!string.IsNullOrWhiteSpace(fallbackDescription))
            return fallbackDescription;
        return ValueOrDash(inventoryId);
    }

    private static IReadOnlyList<string> ParseOptionValues(string? rawValue)
    {
        if (string.IsNullOrWhiteSpace(rawValue))
            return Array.Empty<string>();

        return rawValue
            .Split(new[] { ',', ';', '|', '_' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(value => value.Trim(' ', '[', ']', '"', '\''))
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private string ResolveOptionItems(string? rawValue)
    {
        var values = ParseOptionValues(rawValue);
        if (values.Count == 0)
            return "-";

        return string.Join(", ", values.Select(value =>
        {
            var item = FindAttachedItem(value);
            return string.IsNullOrWhiteSpace(item?.AccountName) ? value : item.AccountName;
        }));
    }

    private string ResolveOptionGroups(string? rawValue)
    {
        var values = ParseOptionValues(rawValue);
        if (values.Count == 0)
            return "-";

        return string.Join(", ", values.Select(value =>
        {
            var item = availableProducts.FirstOrDefault(product =>
                string.Equals(product.ItemGroupID, value, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(product.ItemGroupName, value, StringComparison.OrdinalIgnoreCase));
            return string.IsNullOrWhiteSpace(item?.ItemGroupName) ? value : item.ItemGroupName;
        }).Distinct(StringComparer.OrdinalIgnoreCase));
    }

    private string ResolveOptionBrands(string? rawValue)
    {
        var values = ParseOptionValues(rawValue);
        if (values.Count == 0)
            return "-";

        return string.Join(", ", values.Select(value =>
        {
            var item = availableProducts.FirstOrDefault(product =>
                string.Equals(product.BrandName, value, StringComparison.OrdinalIgnoreCase));
            return string.IsNullOrWhiteSpace(item?.BrandName) ? value : item.BrandName;
        }).Distinct(StringComparer.OrdinalIgnoreCase));
    }


