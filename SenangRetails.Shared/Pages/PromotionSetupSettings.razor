    private IEnumerable<PromotionSetupModel> FilteredPromotions
    {
        get
        {
            var result = promotions.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                result = result.Where(p => (p.Name?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                           (p.Code?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                           (p.PromoMethod?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                           (p.PromoCondition?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            if (!string.IsNullOrWhiteSpace(selectedTypeFilter))
            {
                result = result.Where(p => p.PromoMethod == selectedTypeFilter || p.PromoType == selectedTypeFilter);
            }

            return result;
        }
    }

    private IEnumerable<InventoryDM> FilteredProductsForPicker
    {
        get
        {
            var result = availableProducts.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(prodSearchQuery))
            {
                result = result.Where(p => (p.AccountName?.Contains(prodSearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                           (p.MasterAccountID?.Contains(prodSearchQuery, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            if (!string.IsNullOrWhiteSpace(prodCategoryFilter))
            {
                result = result.Where(p => p.ItemGroupName == prodCategoryFilter);
            }

            var appliedProductIds = currentPromo.AppliedProductIds
                .Where(id => !string.IsNullOrWhiteSpace(id))
                .Select(id => id.Trim())
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            return result
                .OrderByDescending(product =>
                    !string.IsNullOrWhiteSpace(product.MasterAccountID) &&
                    appliedProductIds.Contains(product.MasterAccountID.Trim()))
                .ThenBy(product => product.AccountName)
                .ThenBy(product => product.MasterAccountID);
        }
    }

