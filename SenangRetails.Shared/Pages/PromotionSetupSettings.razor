@using EBI.DM
@using EBI.UC
@using SenangRetails.Shared.Models.DTOs
@using SenangRetails.Shared.Services
@using SenangRetails.Shared.Services.InventoryService
@inject ProductCacheService CacheService
@inject LocalImageCacheService LocalImageCache
@inject IInventoryService InventorySvc
@inject AppState AppState
@inject IJSRuntime JS

<div class="section-container">
    <div class="section-header">
        <div class="header-left">
            <h2>Promotion Setup</h2>
            <p>Configure promotional pricing, conditions and applied items.</p>
        </div>
        <div class="header-right">
            <button class="add-btn" @onclick="OpenAddModal">+ Add</button>
        </div>
    </div>

    <div class="point-section">
        <div class="section-title-row-with-action">
            <h3>Promotion Rules</h3>
            <span class="rule-count-text">@FilteredPromotions.Count() rule(s)</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(apiLoadError))
        {
            <div class="bc-alert error" style="margin-bottom: 18px;">
                <i class="fa-solid fa-circle-exclamation"></i>
                <span>@apiLoadError</span>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(saveMessage))
        {
            <div class="bc-alert success" style="margin-bottom: 18px;">
                <i class="fa-solid fa-circle-check"></i>
                <span>@saveMessage</span>
            </div>
        }

        <div class="search-toolbar-row promotion-api-toolbar">
            <div class="staff-search-wrap">
                <i class="fa-solid fa-magnifying-glass staff-search-icon"></i>
                <input type="text"
                       class="staff-search-input"
                       placeholder="Search promotion by name or code..."
                       @bind="searchQuery"
                       @bind:event="oninput" />
                @if (!string.IsNullOrEmpty(searchQuery))
                {
                    <button class="search-clear-btn" @onclick='() => searchQuery = ""'>✕</button>
                }
            </div>
            <select class="form-control promotion-api-filter" @bind="selectedTypeFilter">
                <option value="">All Promotion Methods</option>
                <option value="Discount %">Discount %</option>
                <option value="Fixed Unit Price">Fixed Unit Price</option>
                <option value="Discount Amt">Discount Amount</option>
                <option value="Bundled Discount Amt">Bundled Discount Amount</option>
                <option value="Lumpsum Disc Amt">Lump Sum Discount</option>
                <option value="Fixed Lumpsum Price">Lump Sum Fixed Price</option>
                <option value="No Effect">No Effect</option>
            </select>
        </div>
        @if (isLoading)
        {
            <div class="empty-state">Loading promotion rules...</div>
        }
        else if (!FilteredPromotions.Any())
        {
            <div class="empty-state">No promotion rules configured yet.</div>
        }
        else
        {
            <div class="list-container">
                <div class="list-header">
                    <span class="align-left">Code</span>
                    <span class="align-left">Promotion Name</span>
                    <span>Method</span>
                    <span>Value</span>
                    <span>Condition</span>
                    <span>Min Qty</span>
                    <span>Products</span>
                    <span>Status</span>
                    <span>Actions</span>
                </div>
                @foreach (var promo in FilteredPromotions)
                {
                    <div class="list-item" @onclick="() => OpenEditModal(promo)">
                        <span class="cell-main align-left" data-label="Code"><span class="ps-code-badge">@promo.Code</span></span>
                        <span class="cell align-left" data-label="Promotion Name"><strong>@promo.Name</strong></span>
                        <span class="cell align-center" data-label="Method">@promo.PromoMethod</span>
                        <span class="cell align-center" data-label="Value">@GetPromoRateDisplay(promo)</span>
                        <span class="cell align-center" data-label="Condition">@promo.PromoCondition</span>
                        <span class="cell align-center" data-label="Min Qty">@promo.MinQuantity</span>
                        <span class="cell align-center" data-label="Products">@GetAppliedProductsSummary(promo)</span>
                        <span class="cell align-center" data-label="Status">
                            <span class="bc-status-pill @(promo.IsActive ? "active" : "inactive")">
                                @(promo.IsActive ? "Active" : "Disabled")
                            </span>
                        </span>
                        <span class="cell align-center" data-label="Actions" @onclick:stopPropagation>
                            <button type="button" class="pt-action-btn" title="Edit" @onclick="() => OpenEditModal(promo)">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </button>
                            <button type="button" class="pt-action-btn pt-delete-btn" title="Delete" @onclick="() => ConfirmDelete(promo)">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </span>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- ADD / EDIT PROMOTION MODAL (POINT SETUP STYLE) -->
@if (showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-box" style="width: 580px; max-width: 95%;" @onclick:stopPropagation>
            <!-- Modal Header -->
            <div class="modal-header">
                <h3 class="modal-title">@(isEditMode ? "Edit Promotion Rule" : "Add Promotion Rule")</h3>
                <button type="button" class="close-btn" @onclick="CloseModal" aria-label="Close">✕</button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="form-error">@errorMessage</div>
                }

                <!-- Section Tabs -->
                <div class="staff-tab-bar" style="margin-bottom: 20px;">
                    <button type="button"
                            class="staff-tab @(activeTab == "GeneralSetup" ? "active" : "")"
                            @onclick='() => activeTab = "GeneralSetup"'>
                        General Setup
                    </button>
                    <button type="button"
                            class="staff-tab @(activeTab == "DiscountLimits" ? "active" : "")"
                            @onclick='() => activeTab = "DiscountLimits"'>
                        Discount &amp; Limits
                    </button>
                    <button type="button"
                            class="staff-tab @(activeTab == "AppliedProducts" ? "active" : "")"
                            @onclick='() => activeTab = "AppliedProducts"'>
                        Applied Products @(currentPromo.AppliedProductIds?.Count > 0 ? $"({currentPromo.AppliedProductIds.Count})" : "")
                    </button>
                </div>

                @if (activeTab == "GeneralSetup")
                {
                    <!-- InventoryFull.objInventory.MasterAccountID -->
                    <div class="form-group">
                        <label class="form-label">Item ID</label>
                        <input type="text"
                               class="form-control readonly"
                               value="@currentPromo.MasterAccountID"
                               placeholder="Assigned by server after save"
                               readonly />
                    </div>

                    <!-- InventoryFull.objInventory.DisplayCode -->
                    <div class="form-group">
                        <label class="form-label">Display Code <span class="required">*</span></label>
                        <input type="text"
                               class="form-control text-uppercase @(isEditMode ? "readonly" : "")"
                               placeholder="e.g. PROMO-101"
                               @bind="currentPromo.Code"
                               disabled="@isEditMode" />
                        @if (isEditMode)
                        {
                            <span class="field-sub-hint">Display code is unique and locked after creation.</span>
                        }
                    </div>

                    <!-- InventoryFull.objInventory.AccountName / IsSold -->
                    <div class="form-group">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                            <label class="form-label" style="margin: 0;">Promotion Name <span class="required">*</span></label>
                            <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
                                <div class="modal-active-row">
                                    <input type="checkbox" id="promoIsActive" class="staff-checkbox"
                                           @bind="currentPromo.IsActive" />
                                    <label for="promoIsActive" class="staff-checkbox-label">Is Sold</label>
                                </div>
                                <div class="modal-active-row">
                                    <input type="checkbox" id="promoConfirmed" class="staff-checkbox"
                                           @bind="currentPromo.IsConfirmed" />
                                    <label for="promoConfirmed" class="staff-checkbox-label">Is Confirmed</label>
                                </div>
                            </div>
                        </div>
                        <input type="text"
                               class="form-control"
                               placeholder="e.g. Happy Hour 20% OFF"
                               @bind="currentPromo.Name" />
                    </div>

                    <!-- InventoryFull.objInventory.Remarks -->
                    <div class="form-group">
                        <label class="form-label">Remarks / Description</label>
                        <textarea class="form-control"
                                  rows="2"
                                  style="resize: vertical; min-height: 60px;"
                                  placeholder="Optional promotion notes or terms..."
                                  @bind="currentPromo.Remarks"></textarea>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Primary Branch</label>
                        <select class="form-control"
                                value="@currentPromo.BranchID"
                                @onchange="OnPrimaryBranchChanged">
                            <option value="">Select Branch</option>
                            @foreach (var branchId in AvailablePromotionBranches)
                            {
                                <option value="@branchId">@branchId</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Available Branches</label>
                        <div class="promotion-branch-options">
                            @if (!AvailablePromotionBranches.Any())
                            {
                                <span class="field-sub-hint">No available branches.</span>
                            }
                            else
                            {
                                @foreach (var branchId in AvailablePromotionBranches)
                                {
                                    <label class="promotion-branch-option">
                                        <input type="checkbox"
                                               class="staff-checkbox"
                                               checked="@IsPromotionBranchAvailable(branchId)"
                                               @onchange="() => TogglePromotionBranch(branchId)" />
                                        <span>@branchId</span>
                                    </label>
                                }
                            }
                        </div>
                    </div>

                    <!-- InventoryFull.objInventory.AvailableDateFrom / AvailableDateTo -->
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                        <div class="form-group">
                            <label class="form-label">Available Date From</label>
                            <MobileDatePicker @bind-Value="currentPromo.StartDate"
                                              DateFormat="dd/MM/yyyy"
                                              Placeholder="Start Date" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Available Date To</label>
                            <MobileDatePicker @bind-Value="currentPromo.EndDate"
                                              DateFormat="dd/MM/yyyy"
                                              Placeholder="End Date" />
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                        <div class="form-group">
                            <label class="form-label">Available Time From</label>
                            <input type="time"
                                   class="form-control"
                                   step="1"
                                   value="@FormatTimeInput(currentPromo.AvailableTimeFrom)"
                                   @onchange="OnAvailableTimeFromChanged" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Available Time To</label>
                            <input type="time"
                                   class="form-control"
                                   step="1"
                                   value="@FormatTimeInput(currentPromo.AvailableTimeTo)"
                                   @onchange="OnAvailableTimeToChanged" />
                        </div>
                    </div>

                }
                else if (activeTab == "DiscountLimits")
                {
                    <!-- InventoryFull.objInventory.lstPackage[].PromotionMethod -->
                    <div class="form-group">
                        <label class="form-label">Promotion Method <span class="required">*</span></label>
                        <select class="form-control" @bind="currentPromo.PromoMethod">
                            <option value="Discount %">Discount % (Percentage)</option>
                            <option value="Fixed Unit Price">Fixed Unit Price (RM)</option>
                            <option value="Discount Amt">Discount Amount (RM)</option>
                            <option value="Bundled Discount Amt">Bundled Discount Amount (RM)</option>
                            <option value="Lumpsum Disc Amt">Lumpsum Discount Amount (RM)</option>
                            <option value="Fixed Lumpsum Price">Fixed Lumpsum Price (RM)</option>
                            <option value="No Effect">No Effect</option>
                        </select>
                    </div>

                    <!-- InventoryFull.objInventory.lstPackage[].UnitActualValue -->
                    <div class="form-group">
                        <label class="form-label">Unit Actual Value <span class="required">*</span></label>
                        <div class="ps-input-with-action">
                            <input type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control"
                                   @bind="currentPromo.DiscountValue"
                                   placeholder="0.00" />
                            <button type="button"
                                    class="input-keypad-btn"
                                    title="Open touch keypad"
                                    @onclick='() => OpenKeypad("DiscountValue", currentPromo.DiscountValue, "Unit Actual Value")'>
                                <i class="fa-solid fa-calculator"></i>
                            </button>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Maximum Discount Limit</label>
                        <input type="number" step="0.01" min="0" class="form-control" @bind="currentPromo.MaxDiscountLimit" />
                    </div>

                    <!-- InventoryFull.objInventory.lstPackage[].PromoCondition -->
                    <div class="form-group">
                        <label class="form-label">Promotion Condition <span class="required">*</span></label>
                        <select class="form-control" @bind="currentPromo.PromoCondition">
                            <option value="No Condition">No Condition</option>
                            <option value="Total Price After Discount, Disc To All Items">Total Price After Discount (Disc To All)</option>
                            <option value="Total Price After Discount">Total Price After Discount</option>
                            <option value="Total Quantity Bought, Disc To All Items">Total Quantity Bought (Disc To All)</option>
                            <option value="Total Quantity Bought">Total Quantity Bought</option>
                            <option value="Total Price Before Discount, Disc To All Items">Total Price Before Discount (Disc To All)</option>
                            <option value="Total Price Before Discount">Total Price Before Discount</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Promotion Condition Amount</label>
                        <input type="number"
                               step="0.01"
                               min="0"
                               class="form-control"
                               @bind="currentPromo.PromoConditionAmount" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Promotion Priority</label>
                        <input type="number"
                               step="1"
                               min="0"
                               class="form-control"
                               @bind="currentPromo.PromoPriority" />
                    </div>

                    <!-- InventoryFull.objInventory.lstPackage[].RoundingOption -->
                    <div class="form-group">
                        <label class="form-label">Rounding Option</label>
                        <select class="form-control" @bind="currentPromo.Rounding">
                            <option value="No Rounding">No Rounding</option>
                            <option value="Round To5Cent">Round To 5 Cents</option>
                            <option value="Round Up To10Cent">Round Up To 10 Cents</option>
                            <option value="Round Up To Dollar">Round Up To Dollar</option>
                            <option value="Round Down To10Cent">Round Down To 10 Cents</option>
                            <option value="Round Down To Dollar">Round Down To Dollar</option>
                        </select>
                    </div>

                    <!-- InventoryFull.objInventory.lstPackage[].Quantity / MaxQuantity -->
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                        <div class="form-group">
                            <label class="form-label">Quantity</label>
                            <div class="ps-input-with-action">
                                <input type="number"
                                       min="1"
                                       class="form-control"
                                       @bind="currentPromo.MinQuantity" />
                                <button type="button"
                                        class="input-keypad-btn"
                                        title="Open touch keypad"
                                        @onclick='() => OpenKeypad("MinQuantity", currentPromo.MinQuantity, "Quantity")'>
                                    <i class="fa-solid fa-calculator"></i>
                                </button>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Maximum Quantity</label>
                            <div class="ps-input-with-action">
                                <input type="number"
                                       min="0"
                                       step="1"
                                       inputmode="numeric"
                                       class="form-control"
                                       @bind="currentPromo.MaxLimitPerOrder"
                                       @bind:event="oninput"
                                       placeholder="0 (Unlimited)" />
                                <button type="button"
                                        class="input-keypad-btn"
                                        title="Open touch keypad"
                                        @onclick='() => OpenKeypad("MaxLimitPerOrder", currentPromo.MaxLimitPerOrder, "Maximum Quantity")'>
                                    <i class="fa-solid fa-calculator"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                }
                else if (activeTab == "AppliedProducts")
                {
                    <div class="ps-picker-container">
                        <!-- Top Toolbar: Search + Category -->
                        <div style="display: flex; gap: 8px; margin-bottom: 10px; align-items: center;">
                            <div class="staff-search-wrap" style="flex: 1;">
                                <i class="fa-solid fa-magnifying-glass"></i>
                                <input type="text"
                                       class="staff-search-input"
                                       placeholder="Search products..."
                                       @bind="prodSearchQuery"
                                       @bind:event="oninput" />
                                @if (!string.IsNullOrEmpty(prodSearchQuery))
                                {
                                    <button type="button" class="staff-search-clear" @onclick='() => prodSearchQuery = ""'>✕</button>
                                }
                            </div>
                            <select class="form-control" style="width: 150px; padding: 10px 12px;" @bind="prodCategoryFilter">
                                <option value="">All Categories</option>
                                @foreach (var cat in availableCategories)
                                {
                                    <option value="@cat">@cat</option>
                                }
                            </select>
                        </div>

                        <!-- Quick Selection Stats & Action Buttons -->
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; padding: 4px 2px;">
                            <span style="font-size: 13px; font-weight: 600; color: #555;">
                                <strong style="color: var(--color-primary, #f2600c);">@(currentPromo.AppliedProductIds?.Count ?? 0)</strong> items selected
                            </span>
                            <div style="display: flex; gap: 8px;">
                                <button type="button" class="btn-picker-action" @onclick="SelectAllFilteredProducts">
                                    Select All (@FilteredProductsForPicker.Count())
                                </button>
                                @if (currentPromo.AppliedProductIds != null && currentPromo.AppliedProductIds.Any())
                                {
                                    <button type="button" class="btn-picker-action danger" @onclick="ClearAllProducts">
                                        Clear All
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- Product List -->
                        <div class="ps-prod-scroll-list">
                            @if (!FilteredProductsForPicker.Any())
                            {
                                <div style="text-align: center; padding: 30px 10px; color: #888;">
                                    <i class="fa-solid fa-box-open" style="font-size: 2rem; color: #ccc; margin-bottom: 8px; display: block;"></i>
                                    <span>No products found matching filter.</span>
                                </div>
                            }
                            else
                            {
                                @foreach (var prod in FilteredProductsForPicker)
                                {
                                    var isChecked = !string.IsNullOrEmpty(prod.MasterAccountID) && currentPromo.AppliedProductIds.Any(id => string.Equals(id?.Trim(), prod.MasterAccountID.Trim(), StringComparison.OrdinalIgnoreCase));
                                    var imgUrl = GetDisplayImageUrl(prod);

                                    <div class="ps-prod-item @(isChecked ? "selected" : "")"
                                         @onclick="() => ToggleProductSelection(prod.MasterAccountID)">
                                        <div class="custom-tick-checkbox @(isChecked ? "checked" : "")" style="flex-shrink: 0;">
                                            @if (isChecked)
                                            {
                                                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                            }
                                        </div>

                                        @if (!string.IsNullOrEmpty(imgUrl))
                                        {
                                            <img src="@imgUrl" alt="@prod.AccountName" class="ps-prod-img" />
                                        }
                                        else
                                        {
                                            <div class="ps-prod-img-placeholder">
                                                <i class="fa-solid fa-box"></i>
                                            </div>
                                        }

                                        <div style="flex: 1; min-width: 0;">
                                            <div style="font-size: 13.5px; font-weight: 600; color: #222; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                                @prod.AccountName
                                            </div>
                                            <div style="display: flex; gap: 8px; align-items: center; margin-top: 2px;">
                                                @if (!string.IsNullOrEmpty(prod.ItemGroupName))
                                                {
                                                    <span class="ps-badge-tag">@prod.ItemGroupName</span>
                                                }
                                                <span style="font-size: 12px; color: #888;">RM @prod.SalesPrice.ToString("N2")</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }

                @if (isEditMode)
                {
                    <div style="margin-top: 14px; padding-top: 14px; border-top: 1px solid #f0f0f0;">
                        <button type="button" class="btn-delete-row" @onclick="() => ConfirmDelete(currentPromo)">
                            <i class="fa-solid fa-trash-can" style="margin-right: 6px;"></i> Delete Promotion Rule
                        </button>
                    </div>
                }
            </div>

            <!-- Modal Footer (Matching Staff & Point Setup style) -->
            <div class="modal-footer">
                <button type="button" class="btn-cancel" @onclick="CloseModal">Cancel</button>
                <button type="button" class="btn-save" @onclick="SavePromo" disabled="@isSaving">
                    @(isSaving ? "Saving..." : "Save")
                </button>
            </div>
        </div>
    </div>
}


<!-- TOUCH CALCULATOR KEYPAD MODAL -->
@if (showKeypad)
{
    <div class="modal-overlay" @onclick="CloseKeypad">
        <div class="touch-keypad-modal" @onclick:stopPropagation>
            <div class="keypad-header">
                <span class="keypad-title">Enter @keypadTitle</span>
                <span class="keypad-display">@keypadValueString</span>
            </div>
            <div class="keypad-grid">
                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("7")'>7</button>
                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("8")'>8</button>
                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("9")'>9</button>
                <button type="button" class="kp-btn kp-action" @onclick="KeypadClear">CE</button>

                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("4")'>4</button>
                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("5")'>5</button>
                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("6")'>6</button>
                <button type="button" class="kp-btn kp-action" @onclick="KeypadBackspace">⌫</button>

                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("1")'>1</button>
                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("2")'>2</button>
                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("3")'>3</button>
                <button type="button" class="kp-btn kp-cancel" @onclick="CloseKeypad">Cancel</button>

                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("0")'>0</button>
                <button type="button" class="kp-btn" @onclick='() => KeypadAppend("00")'>00</button>
                <button type="button" class="kp-btn" @onclick='() => KeypadAppend(".")'>.</button>
                <button type="button" class="kp-btn kp-submit" @onclick="KeypadSave">OK</button>
            </div>
        </div>
    </div>
}

<!-- DELETE CONFIRMATION MODAL -->
@if (showDeleteModal && promoToDelete != null)
{
    <div class="modal-overlay" @onclick="() => showDeleteModal = false">
        <div class="modal-container ps-del-modal" @onclick:stopPropagation>
            <div class="modal-header">
                <div class="ps-del-header-left">
                    <div class="ps-del-icon-badge">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                    <div>
                        <h3 class="ps-modal-title" style="color: #DC2626;">Confirm Deletion</h3>
                        <span class="ps-modal-sub">This action cannot be undone.</span>
                    </div>
                </div>
            </div>
            <div class="modal-body" style="padding: 1.25rem;">
                <p style="margin: 0; font-size: 0.95rem; color: #334155; line-height: 1.5;">
                    Are you sure you want to delete promotion
                    <strong style="color: #0F172A; font-weight: 700;">@promoToDelete.Name</strong> (<span style="font-family: monospace;">@promoToDelete.Code</span>)?
                </p>
            </div>
            <div class="prod-modal-footer">
                <button class="prod-modal-cancel-btn touch-target" @onclick="() => showDeleteModal = false">Cancel</button>
                <button class="prod-modal-save-btn touch-target" style="background: #DC2626;" @onclick="ExecuteDelete">Delete Promotion</button>
            </div>
        </div>
    </div>
}

<style>
    /* ══════════════════════════════════════════════════
       POINT SETUP PAGE UI STYLING
       ══════════════════════════════════════════════════ */
    .section-container {
        padding: 20px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 0.875rem; /* 14px base */
        padding: clamp(0px, 4vw, 18px) clamp(16px, 4vw, 34px);
    }

    .section-header {
        margin-bottom: 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
    }

    .header-left h2 {
        font-size: 1.25rem; /* 20px */
        font-weight: 600;
        color: #333;
        margin: 0;
    }

    .header-left p {
        color: #888;
        font-size: 0.875rem; /* 14px */
        margin: 5px 0 0;
    }

    .header-right {
        flex-shrink: 0;
    }

    .point-section {
        background: white;
        border: 1px solid #eee;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 20px;
        overflow-x: auto;
    }

    .section-title-row-with-action {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 20px;
    }

    .section-title-row-with-action h3 {
        font-size: 1rem; /* 16px */
        font-weight: 600;
        color: #222;
        margin: 0;
    }

    .rule-count-text {
        font-size: 0.8125rem;
        color: #888;
    }

    .add-btn {
        background: var(--color-primary, #F2600C);
        color: white;
        border: none;
        padding: 8px 20px;
        border-radius: 8px;
        font-size: 0.875rem; /* 14px */
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        white-space: nowrap;
    }

    .add-btn:hover {
        transform: translateY(-1px);
        opacity: 0.95;
    }

    .search-toolbar-row {
        margin-bottom: 18px;
    }

    .staff-search-wrap {
        position: relative;
        width: 100%;
        max-width: 420px;
    }

    .staff-search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #888;
        font-size: 14px;
    }

    .staff-search-input {
        width: 100%;
        padding: 9px 36px 9px 34px;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 13.5px;
        font-family: inherit;
        background: white;
        box-sizing: border-box;
    }

    .staff-search-input:focus {
        outline: none;
        border-color: var(--color-primary, #F2600C);
    }

    .search-clear-btn {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: #888;
        cursor: pointer;
        font-size: 12px;
    }

    .empty-state {
        font-size: 0.75rem; /* 12px */
        color: #bbb;
        padding: 20px 0;
        text-align: center;
    }

    /* List table - Desktop view */
    .list-container {
        display: flex;
        flex-direction: column;
        width: 100%;
    }

    .list-header {
        display: grid;
        grid-template-columns: 1fr 1.8fr 1.1fr 1.1fr 0.8fr 1fr 1.2fr 0.8fr 0.8fr;
        padding: 12px 0;
        font-size: 0.875rem; /* 14px */
        font-weight: 600;
        color: #333;
        border-bottom: 1px solid #ddd;
    }

    .list-item {
        display: grid;
        grid-template-columns: 1fr 1.8fr 1.1fr 1.1fr 0.8fr 1fr 1.2fr 0.8fr 0.8fr;
        padding: 16px 0;
        background: white;
        border-bottom: 1px solid #eee;
        align-items: center;
        cursor: pointer;
        transition: background 0.15s;
    }

    .list-item:hover {
        background-color: #fafafa;
    }

    .cell-main {
        font-weight: 600;
        color: #333;
    }

    .cell {
        color: #555;
    }

    .align-left { text-align: left; }
    .align-center { text-align: center; }
    .align-right { text-align: right; }

    /* Action buttons */
    .pt-action-btn {
        background: transparent;
        border: none;
        color: #64748B;
        cursor: pointer;
        padding: 6px 8px;
        border-radius: 6px;
        font-size: 0.95rem;
        transition: all 0.15s;
    }

    .pt-action-btn:hover {
        background: #F1F5F9;
        color: var(--color-primary, #F2600C);
    }

    .pt-delete-btn:hover {
        background: #FEF2F2;
        color: #DC2626;
    }

    .ps-code-badge {
        display: inline-block;
        padding: 0;
        background: transparent;
        color: #334155;
        border: 0;
        border-radius: 0;
        box-shadow: none;
        font-weight: 700;
        font-family: monospace;
        font-size: 0.85rem;
        letter-spacing: 0;
    }

    .bc-format-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 2px 8px;
        background: #F1F5F9;
        color: #475569;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 500;
    }

    .bc-status-pill {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .bc-status-pill.active {
        background: #DCFCE7;
        color: #166534;
    }

    .bc-status-pill.inactive {
        background: #F1F5F9;
        color: #64748B;
    }

    .bc-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 500;
    }

    .bc-alert.success {
        background: #F0FDF4;
        border: 1px solid #BBF7D0;
        color: #166534;
    }

    .bc-alert.error {
        background: #FEF2F2;
        border: 1px solid #FECACA;
        color: #991B1B;
    }

    /* ══════════════════════════════════════════════════
       MODAL STYLING
       ══════════════════════════════════════════════════ */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 16px;
    }

    .modal-container {
        background: white;
        border-radius: 16px;
        width: 100%;
        max-width: 900px;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
        box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04);
        overflow: hidden;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 20px;
        border-bottom: 1px solid #eee;
        background: #FAFAFA;
    }

    .ps-modal-header-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .ps-modal-icon-badge {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: #FFF7ED;
        color: var(--color-primary, #F2600C);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .ps-modal-title {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 600;
        color: #1E293B;
    }

    .ps-modal-sub {
        font-size: 0.8rem;
        color: #64748B;
    }

    .close-btn {
        background: none;
        border: none;
        font-size: 1.2rem;
        color: #94A3B8;
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 6px;
    }

    .close-btn:hover {
        background: #F1F5F9;
        color: #334155;
    }

    .modal-body {
        padding: 20px;
        overflow-y: auto;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .ps-grid-2col {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: 16px;
    }

    .ps-col {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .ps-section-box {
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        padding: 14px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .ps-section-header {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        color: #475569;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding-bottom: 8px;
        border-bottom: 1px solid #E2E8F0;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .form-label {
        font-size: 0.8125rem;
        font-weight: 600;
        color: #334155;
    }

    .form-label .required {
        color: #EF4444;
    }

    .form-control {
        width: 100%;
        padding: 8px 12px;
        border: 1px solid #CBD5E1;
        border-radius: 8px;
        font-size: 0.875rem;
        box-sizing: border-box;
        background: white;
        font-family: inherit;
    }

    .form-control:focus {
        outline: none;
        border-color: var(--color-primary, #F2600C);
    }

    .form-control.readonly {
        background: #F1F5F9;
        cursor: not-allowed;
    }

    .text-uppercase { text-transform: uppercase; }
    .text-mono { font-family: monospace; }

    .ps-field-hint {
        font-size: 0.75rem;
        color: #64748B;
    }

    .touch-pill-group {
        display: flex;
        gap: 8px;
    }

    .touch-pill {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 8px 12px;
        border-radius: 8px;
        border: 1px solid #CBD5E1;
        background: white;
        font-size: 0.85rem;
        font-weight: 500;
        color: #475569;
        cursor: pointer;
        transition: all 0.15s;
    }

    .touch-pill.active {
        background: #FFF7ED;
        border-color: var(--color-primary, #F2600C);
        color: var(--color-primary, #F2600C);
        font-weight: 600;
    }

    .picker-field {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 12px;
        background: white;
        border: 1px solid #CBD5E1;
        border-radius: 8px;
        cursor: pointer;
    }

    .picker-field:hover {
        border-color: var(--color-primary, #F2600C);
    }

    .picker-field-left {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .picker-icon {
        color: #64748B;
        font-size: 0.9rem;
    }

    .picker-value {
        font-weight: 600;
        color: #1E293B;
    }

    .picker-tap-btn {
        font-size: 0.8rem;
        color: var(--color-primary, #F2600C);
        font-weight: 500;
    }

    .ps-grid-2col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .ps-toggle-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 14px;
        background: white;
        border: 1px solid #E2E8F0;
        border-radius: 8px;
        cursor: pointer;
    }

    .ps-toggle-card.checked {
        border-color: var(--color-primary, #F2600C);
        background: #FFFBF7;
    }

    .ps-toggle-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .ps-toggle-left i {
        color: #64748B;
    }

    .ps-toggle-title {
        display: block;
        font-weight: 600;
        font-size: 0.85rem;
        color: #1E293B;
    }

    .ps-toggle-desc {
        display: block;
        font-size: 0.75rem;
        color: #64748B;
    }

    .custom-checkbox {
        width: 18px;
        height: 18px;
        accent-color: var(--color-primary, #F2600C);
        cursor: pointer;
    }

    /* Product Picker section */
    .ps-picker-section {
        max-height: 520px;
        display: flex;
        flex-direction: column;
    }

    .ps-picker-header-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .ps-picker-counter {
        font-size: 0.75rem;
        color: #64748B;
    }

    .ps-picker-quick-actions {
        display: flex;
        gap: 6px;
    }

    .ps-picker-quick-btn {
        padding: 3px 8px;
        border-radius: 4px;
        border: 1px solid #CBD5E1;
        background: white;
        font-size: 0.75rem;
        cursor: pointer;
    }

    .ps-picker-quick-btn.danger {
        color: #DC2626;
        border-color: #FECACA;
    }

    .ps-picker-filter-row {
        display: flex;
        gap: 8px;
        margin-top: 4px;
    }

    .ps-picker-search-wrap {
        position: relative;
        flex: 1;
    }

    .ps-picker-search-wrap i {
        position: absolute;
        left: 10px;
        top: 50%;
        transform: translateY(-50%);
        color: #94A3B8;
        font-size: 0.8rem;
    }

    .ps-picker-search {
        width: 100%;
        padding: 6px 10px 6px 30px;
        border: 1px solid #CBD5E1;
        border-radius: 6px;
        font-size: 0.8rem;
        box-sizing: border-box;
    }

    .ps-picker-cat {
        padding: 6px 10px;
        border: 1px solid #CBD5E1;
        border-radius: 6px;
        font-size: 0.8rem;
        max-width: 130px;
    }

    .ps-picker-list {
        overflow-y: auto;
        max-height: 380px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-top: 6px;
        padding-right: 4px;
    }

    .ps-prod-card {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 10px;
        background: white;
        border: 1px solid #E2E8F0;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.15s;
    }

    .ps-prod-card:hover {
        border-color: #CBD5E1;
    }

    .ps-prod-card.selected {
        border-color: var(--color-primary, #F2600C);
        background: #FFFDFB;
    }

    .ps-prod-check-badge i {
        color: #CBD5E1;
        font-size: 1.1rem;
    }

    .ps-prod-card.selected .ps-prod-check-badge i {
        color: var(--color-primary, #F2600C);
    }

    .ps-prod-thumb {
        width: 36px;
        height: 36px;
        border-radius: 6px;
        object-fit: cover;
    }

    .ps-prod-thumb-icon {
        width: 36px;
        height: 36px;
        border-radius: 6px;
        background: #F1F5F9;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #94A3B8;
    }

    .ps-prod-details {
        flex: 1;
        min-width: 0;
    }

    .ps-prod-title {
        display: block;
        font-size: 0.8125rem;
        font-weight: 600;
        color: #1E293B;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .ps-prod-meta-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 2px;
    }

    .ps-cat-tag {
        font-size: 0.7rem;
        background: #F1F5F9;
        color: #475569;
        padding: 1px 6px;
        border-radius: 4px;
    }

    .ps-orig-price {
        font-size: 0.75rem;
        color: #64748B;
        font-weight: 600;
    }

    .prod-modal-footer {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        padding: 14px 20px;
        border-top: 1px solid #eee;
        background: #FAFAFA;
    }

    .prod-modal-cancel-btn {
        padding: 9px 18px;
        border-radius: 8px;
        border: 1px solid #CBD5E1;
        background: white;
        color: #475569;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
    }

    .prod-modal-cancel-btn.text-danger {
        color: #DC2626;
        border-color: #FECACA;
        margin-right: auto;
    }

    .prod-modal-save-btn {
        padding: 9px 22px;
        border-radius: 8px;
        border: none;
        background: var(--color-primary, #F2600C);
        color: white;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .prod-modal-save-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    /* Keypad Modal */
    .touch-keypad-modal {
        background: white;
        border-radius: 16px;
        width: 320px;
        padding: 16px;
        box-shadow: 0 20px 25px -5px rgba(0,0,0,0.2);
    }
    .keypad-header {
        display: flex;
        flex-direction: column;
        gap: 4px;
        margin-bottom: 14px;
        background: #F8FAFC;
        padding: 12px;
        border-radius: 10px;
        text-align: right;
    }
    .keypad-title { font-size: 0.75rem; color: #64748B; text-align: left; }
    .keypad-display { font-size: 1.5rem; font-weight: 700; font-family: monospace; color: #0F172A; }
    .keypad-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .kp-btn {
        padding: 14px 0;
        border: 1px solid #E2E8F0;
        border-radius: 8px;
        background: white;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.1s;
    }
    .kp-btn:hover { background: #F1F5F9; }
    .kp-action { background: #F1F5F9; color: #475569; }
    .kp-cancel { background: #FEE2E2; color: #DC2626; font-size: 0.85rem; }
    .kp-submit { background: var(--color-primary, #F2600C); color: white; font-size: 0.95rem; }

    /* Delete modal */
    .ps-del-modal { max-width: 440px; }
    .ps-del-header-left { display: flex; align-items: center; gap: 12px; }
    .ps-del-icon-badge {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: #FEF2F2;
        color: #DC2626;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    /* ══════════════════════════════════════════════════
       RESPONSIVE MOBILE CARDS
       ══════════════════════════════════════════════════ */
    @@media (max-width: 768px) {
        .section-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
        }

        .header-right {
            width: 100%;
        }

        .header-right .add-btn {
            width: 100%;
            text-align: center;
            padding: 12px;
        }

        .point-section {
            padding: 15px;
        }

        .list-header {
            display: none;
        }

        .list-item {
            display: flex;
            flex-direction: column;
            gap: 8px;
            padding: 14px;
            margin-bottom: 12px;
            border: 1px solid #eee;
            border-radius: 10px;
            background: #FAFAFA;
        }

        .cell, .cell-main {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            text-align: right !important;
            font-size: 0.8125rem;
        }

        .cell::before, .cell-main::before {
            content: attr(data-label);
            font-weight: 600;
            color: #888;
            text-align: left;
            padding-right: 10px;
        }

        .cell[data-label="Actions"] {
            justify-content: flex-end;
            padding-top: 8px;
            border-top: 1px dashed #eee;
        }

        .cell[data-label="Actions"]::before {
            display: none;
        }

        .ps-grid-2col {
            grid-template-columns: 1fr;
        }
    }

    /* ========================================================================= */
    /* CLEAN PROMOTION MODAL STYLING (MATCHING POINT & STAFF SETUP)              */
    /* ========================================================================= */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        backdrop-filter: blur(2px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050;
        padding: 16px;
    }

    .modal-box {
        background: white;
        border-radius: 16px;
        width: 580px;
        max-width: 95%;
        max-height: 90vh;
        max-height: 90dvh;
        display: flex;
        flex-direction: column;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
        overflow: hidden;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .modal-header {
        padding: 20px 24px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #f0f0f0;
        flex-shrink: 0;
    }

    .modal-title {
        font-size: 18px;
        font-weight: 700;
        color: #1a1a1a;
        margin: 0;
    }

    .close-btn {
        background: none;
        border: none;
        font-size: 20px;
        color: #888;
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 6px;
        line-height: 1;
        transition: 0.15s;
    }

    .close-btn:hover {
        background: #f0f0f0;
        color: #111;
    }

    .modal-body {
        padding: 20px 24px;
        overflow-y: auto;
        flex: 1;
        box-sizing: border-box;
    }

    .modal-footer {
        padding: 16px 24px;
        display: flex;
        gap: 12px;
        border-top: 1px solid #f0f0f0;
        flex-shrink: 0;
    }

    .btn-cancel {
        flex: 1;
        padding: 13px;
        border: 1px solid #ddd;
        border-radius: 10px;
        background: white;
        font-size: 15px;
        font-weight: 600;
        color: #444;
        cursor: pointer;
        transition: 0.2s;
        font-family: inherit;
        text-align: center;
    }

    .btn-cancel:hover {
