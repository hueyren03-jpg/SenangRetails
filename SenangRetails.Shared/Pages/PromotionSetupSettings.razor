        rule.PromoConditionAmt = form.PromoConditionAmount;
        rule.MaxQuantity = form.MaxLimitPerOrder;
        rule.RoundingOption = GetRoundingId(form.Rounding);
        rule.PackageQuantityTypeID = form.PackageQuantityTypeID;
        rule.OptionItems = form.OptionItems;
        rule.OptionGroups = form.OptionGroups;
        rule.OptionBrands = form.OptionBrands;
        rule.HeaderCaption = form.HeaderCaption;
        rule.CustomRules = form.CustomRules;
        rule.IsConfirmed = form.IsConfirmed;
        rule.IsDeferred = form.IsDeferred;
        rule.IsVoided = false;
        rule.IsDirty = true;
        rule.SaveAction = isNew || string.IsNullOrWhiteSpace(rule.AutoID)
            ? EBI.Enum.EntityState.Added
            : EBI.Enum.EntityState.Changed;
    }

    private void ConfirmDelete(PromotionSetupModel promo)
    {
        promoToDelete = promo;
        showDeleteModal = true;
    }

    private async Task ExecuteDelete()
    {
        if (promoToDelete == null)
            return;

        if (string.IsNullOrWhiteSpace(promoToDelete.MasterAccountID))
        {
            errorMessage = "The promotion has no InventoryFull account ID and cannot be deleted.";
            showDeleteModal = false;
            return;
        }

        isSaving = true;
        try
        {
            var (success, message) = await InventorySvc.DeleteItemAsync(promoToDelete.MasterAccountID);
            if (!success)
            {
                errorMessage = string.IsNullOrWhiteSpace(message)
                    ? "The promotion could not be deleted by InventoryFull."
                    : $"The promotion could not be deleted: {message}";
                showDeleteModal = false;
                return;
            }

            var deletedName = promoToDelete.Name;
            showDeleteModal = false;
            showModal = false;
            promoToDelete = null;
            await LoadPromotions();
            saveMessage = $"{deletedName} was deleted successfully.";
        }
        catch (Exception ex)
        {
            errorMessage = $"The promotion could not be deleted: {ex.Message}";
            showDeleteModal = false;
        }
        finally
        {
            isSaving = false;
        }
    }

    // Touch Keypad Methods
    private void OpenKeypad(string field, object? currentVal, string title)
    {
        keypadField = field;
        keypadTitle = title;
        keypadValueString = currentVal switch
        {
            decimal d => d == 0 ? "0" : d.ToString("0.##"),
            int i => i.ToString(),
            _ => "0"
        };
        showKeypad = true;
    }

    private void KeypadAppend(string val)
    {
        if (keypadValueString == "0" && val != ".")
            keypadValueString = val;
        else if (!(val == "." && keypadValueString.Contains(".")))
            keypadValueString += val;
    }

    private void KeypadClear() => keypadValueString = "0";

    private void KeypadBackspace()
    {
        if (keypadValueString.Length > 1)
            keypadValueString = keypadValueString.Substring(0, keypadValueString.Length - 1);
        else
            keypadValueString = "0";
    }

    private void KeypadSave()
    {
        if (keypadField == "DiscountValue" && decimal.TryParse(keypadValueString, out var dVal))
        {
            currentPromo.DiscountValue = dVal;
        }
        else if (keypadField == "MinQuantity" && int.TryParse(keypadValueString, out var mQty))
        {
            currentPromo.MinQuantity = Math.Max(1, mQty);
        }
        else if (keypadField == "MaxLimitPerOrder" && int.TryParse(keypadValueString, out var mLim))
        {
            currentPromo.MaxLimitPerOrder = Math.Max(0, mLim);
        }
        showKeypad = false;
    }

    private void CloseKeypad() => showKeypad = false;
}
