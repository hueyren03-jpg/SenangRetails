@page "/itemsubcategory"
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@using SenangRetails.Shared.Models.DTOs
@using SenangRetails.Shared.Services
@using SenangRetails.Shared.Services.ItemCategoryService
@using SenangRetails.Shared.Services.ItemSubCategoryService
@inject IItemSubCategoryService ItemSubCategoryService
@inject IItemCategoryService ItemCategoryService
@inject LanguageService LangSvc
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="item-subcategory-page">

    <!-- Page Header -->
    <div class="section-header">
        <div class="header-left">
            <div class="header-nav-row">
                @if (ShowRestoreButton)
                {
                    <button class="mobile-menu-btn" @onclick="TriggerToggleSidebar" title="Toggle navigation menu">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                }
                <button class="back-button" @onclick='() => Navigation.NavigateTo("/menu")'>
                    <i class="fa-solid fa-arrow-left"></i>
                    <span>@LangSvc.GetText("Back")</span>
                </button>
            </div>
            <h2>@LangSvc.GetText("ItemSubCategory")</h2>
            <p>Organize categories into sub categories and link each sub category to an item category.</p>
        </div>

        <div class="header-right">
            <button type="button" class="add-btn" @onclick="OpenAddModal">
                <i class="fa-solid fa-plus"></i>
                <span>Add Sub Category</span>
            </button>
        </div>
    </div>

    <!-- Main Card Container -->
    <div class="rules-container">

        <div class="section-title-row-with-action">
            <h3>Sub Category Records</h3>
            <span class="rule-count-text">@FilteredSubCategories.Count() of @subCategories.Count sub categories</span>
        </div>

        <!-- Search & Filter Toolbar -->
        <div class="search-toolbar-row">
            <div class="staff-search-wrap">
                <i class="fa-solid fa-magnifying-glass staff-search-icon"></i>
                <input type="text"
                       class="staff-search-input"
                       placeholder="Search sub category code, name or category..."
                       @bind="searchQuery"
                       @bind:event="oninput" />
                @if (!string.IsNullOrEmpty(searchQuery))
                {
                    <button type="button" class="search-clear-btn" @onclick='() => searchQuery = ""'>✕</button>
                }
            </div>

            <div class="filter-controls-wrap">
                <!-- Category Filter Dropdown -->
                <select class="category-filter-select" @bind="categoryFilter">
                    <option value="">All Categories</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                </select>

                <!-- Status Filter Pills -->
                <div class="filter-pills-wrap">
                    <button type="button" class="@PillClass("All")" @onclick='() => statusFilter = "All"'>
                        All (@subCategories.Count)
                    </button>
                    <button type="button" class="@PillClass("Active")" @onclick='() => statusFilter = "Active"'>
                        Active (@subCategories.Count(d => d.Active))
                    </button>
                    <button type="button" class="@PillClass("Inactive")" @onclick='() => statusFilter = "Inactive"'>
                        Inactive (@subCategories.Count(d => !d.Active))
                    </button>
                </div>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="loading-state">
                <div class="loading-spinner"></div>
                <span>Loading sub categories...</span>
            </div>
        }
        else if (!FilteredSubCategories.Any())
        {
            <div class="empty-state">
                <div class="empty-icon-wrap">
                    <i class="fa-solid fa-folder-tree"></i>
                </div>
                <h4>No sub categories found</h4>
                @if (!string.IsNullOrEmpty(searchQuery) || !string.IsNullOrEmpty(categoryFilter) || statusFilter != "All")
                {
                    <p>No results match your search or filter criteria.</p>
                    <button type="button" class="btn-clear-filters" @onclick="ClearFilters">Clear Filters</button>
                }
                else
                {
                    <p>Start organizing your catalog by adding your first item sub category.</p>
                    <button type="button" class="add-btn empty-action-btn" @onclick="OpenAddModal">
                        <i class="fa-solid fa-plus"></i> Add Sub Category
                    </button>
                }
            </div>
        }
        else
        {
            <div class="list-container">
                <div class="list-header">
                    <span class="align-left sortable-cell" @onclick='() => SortBy("Code")'>
                        Sub Category Code
                        @if (sortColumn == "Code") { <span class="sort-caret">@(sortAscending ? "▲" : "▼")</span> }
                    </span>
                    <span class="align-left sortable-cell" @onclick='() => SortBy("Name")'>
                        Sub Category Name
                        @if (sortColumn == "Name") { <span class="sort-caret">@(sortAscending ? "▲" : "▼")</span> }
                    </span>
                    <span class="align-left sortable-cell" @onclick='() => SortBy("Category")'>
                        Item Category
                        @if (sortColumn == "Category") { <span class="sort-caret">@(sortAscending ? "▲" : "▼")</span> }
                    </span>
                    <span class="align-center sortable-cell" @onclick='() => SortBy("Active")'>
                        Active
                        @if (sortColumn == "Active") { <span class="sort-caret">@(sortAscending ? "▲" : "▼")</span> }
                    </span>
                    <span class="align-center">Actions</span>
                </div>

                @foreach (var item in FilteredSubCategories)
                {
                    <div class="@RowClass(item)" @onclick="() => OpenEditModal(item)">

                        <span class="cell align-left" data-label="Sub Category Code">
                            <span class="subcat-code-badge">@item.Code</span>
                        </span>

                        <span class="cell align-left" data-label="Sub Category Name">
                            <span class="subcat-desc-text">@item.Name</span>
                        </span>

                        <span class="cell align-left" data-label="Category">
                            @if (!string.IsNullOrWhiteSpace(item.CategoryName))
                            {
                                <span class="category-tag">
                                    <i class="fa-solid fa-tags tag-icon"></i>
                                    @item.CategoryName
                                </span>
                            }
                            else
                            {
                                <span class="no-category-tag">—</span>
                            }
                        </span>

                        <span class="cell align-center" data-label="Active" @onclick:stopPropagation>
                            <div class="active-cell-wrap">
                                <div class="@TickClass(item.Active)" @onclick="() => ToggleItemActive(item)" title="Toggle active">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                </div>
                                <span class="@BadgeClass(item.Active)">@(item.Active ? "Active" : "Inactive")</span>
                            </div>
                        </span>

                        <span class="cell align-center" data-label="Actions" @onclick:stopPropagation>
                            <div class="action-buttons-wrap">
                                <button type="button" class="pt-action-btn" title="Edit" @onclick="() => OpenEditModal(item)">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </button>
                                <button type="button" class="pt-action-btn pt-delete-btn" title="Delete" @onclick="() => RequestDelete(item)">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>
                        </span>

                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Add / Edit Modal -->
@if (showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="subcategory-modal-box" @onclick:stopPropagation>

            <div class="modal-header">
                <div class="modal-title-wrap">
                    <div class="modal-icon-badge">
                        <i class="fa-solid fa-folder-tree"></i>
                    </div>
                    <h3>@(isEditing ? "Edit Sub Category" : "Add Sub Category")</h3>
                </div>
                <button type="button" class="modal-close-btn" @onclick="CloseModal" aria-label="Close">✕</button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(formError))
                {
                    <div class="form-error-banner">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span>@formError</span>
                    </div>
                }

                <div class="form-group">
                    <label class="form-label" for="subcatCode">
                        Sub Category Code
                        <span class="locked-badge">
                            <i class="fa-solid fa-lock"></i> @(isEditing ? "Locked" : "Auto")
                        </span>
                    </label>
                    <div class="locked-input-wrap">
                        <input type="text"
                               id="subcatCode"
                               class="form-control locked-control"
                               value="@(isEditing && !string.IsNullOrEmpty(currentModel.Code) ? currentModel.Code : "Auto-generated on save")"
                               readonly
                               disabled />
                        <i class="fa-solid fa-lock locked-icon-addon"></i>
                    </div>
                    <span class="form-hint">System-generated unique identifier assigned by the server (cannot be edited)</span>
                </div>

                <div class="form-group">
                    <label class="form-label" for="subcatName">Sub Category Name <span class="required">*</span></label>
                    <input type="text"
                           id="subcatName"
                           class="form-control"
                           placeholder="e.g. Action Figures, Cleansers, Soft Drinks"
                           maxlength="255"
                           @bind="currentModel.Name" />
                    <span class="form-hint">Name of the sub category (saved to SupportingTableName)</span>
                </div>

                <div class="form-group">
                    <label class="form-label" for="subcatCategory">Item Category</label>
                    <select id="subcatCategory" class="form-control" @bind="currentModel.CategoryId">
                        <option value="">-- None (No Category) --</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    </select>
                    <span class="form-hint">Assign this sub category to an item category (saved to ParentID)</span>
                </div>

                <div class="form-group">
                    <div class="active-toggle-row" @onclick="ToggleFormActive">
                        <div class="@FormTickClass">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        </div>
                        <div class="checkbox-label-text">
                            <span class="label-primary">Active</span>
                            <span class="label-secondary">Enable this sub category for use in catalog</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-cancel" @onclick="CloseModal" disabled="@isSaving">Cancel</button>
                <button type="button" class="btn-save" @onclick="SaveSubCategory" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-inline"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (showDeleteConfirm && itemToDelete != null)
{
    <div class="modal-overlay" @onclick="CancelDelete">
        <div class="subcategory-modal-box confirm-modal-box" @onclick:stopPropagation>

            <div class="modal-header confirm-header">
                <div class="delete-icon-badge">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <h3>Delete Sub Category</h3>
            </div>

            <div class="modal-body confirm-body">
                <p>Are you sure you want to delete this sub category?</p>
                <div class="delete-item-preview">
                    <span class="subcat-code-badge">@itemToDelete.Code</span>
                    <strong>@itemToDelete.Name</strong>
                    @if (!string.IsNullOrWhiteSpace(itemToDelete.CategoryName))
                    {
                        <span class="category-tag" style="margin-left: 6px;">@itemToDelete.CategoryName</span>
                    }
                </div>
                <p class="warning-note">This action cannot be undone.</p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-cancel" @onclick="CancelDelete" disabled="@isDeleting">Cancel</button>
                <button type="button" class="btn-delete-confirm" @onclick="ConfirmDelete" disabled="@isDeleting">
                    @if (isDeleting)
                    {
                        <span class="spinner-inline"></span>
                        <span>Deleting...</span>
                    }
                    else
                    {
                        <span>Delete</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Notification Toast -->
@if (!string.IsNullOrEmpty(notificationMessage))
{
    <div class="@ToastClass">
        <i class="fa-solid @ToastIcon"></i>
        <span>@notificationMessage</span>
    </div>
}

@code {
    [Parameter] public EventCallback OnToggleSidebar { get; set; }
    [Parameter] public bool ShowRestoreButton { get; set; } = false;

    private List<ItemSubCategoryModel> subCategories = new();
    private List<ItemCategoryModel> categories = new();
    private bool isLoading = true;

    private string searchQuery = "";
    private string statusFilter = "All";
    private string categoryFilter = "";
    private string sortColumn = "Name";
    private bool sortAscending = true;

    private bool showModal = false;
    private bool isEditing = false;
    private ItemSubCategoryModel currentModel = new();
    private string formError = "";
    private bool isSaving = false;

    private bool showDeleteConfirm = false;
    private ItemSubCategoryModel? itemToDelete = null;
    private bool isDeleting = false;

    private string notificationMessage = "";
    private string notificationType = "success";

    // ── CSS helpers ──────────────────────────────────────────────────────────
    private string PillClass(string filter) =>
        statusFilter == filter ? "filter-pill active" : "filter-pill";

    private string RowClass(ItemSubCategoryModel item) =>
        item.Active ? "list-item" : "list-item item-inactive";

    private string TickClass(bool active) =>
        active ? "custom-tick-checkbox checked" : "custom-tick-checkbox";

    private string BadgeClass(bool active) =>
        active ? "status-badge badge-active" : "status-badge badge-inactive";

    private string FormTickClass =>
        currentModel.Active ? "custom-tick-checkbox checked" : "custom-tick-checkbox";

    private string ToastClass =>
        notificationType == "error" ? "alert-toast alert-error" : "alert-toast alert-success";

    private string ToastIcon =>
        notificationType == "error" ? "fa-circle-exclamation" : "fa-circle-check";

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            var categoriesTask = ItemCategoryService.GetCategoriesAsync();
            var subCategoriesTask = ItemSubCategoryService.GetSubCategoriesAsync();

            await Task.WhenAll(categoriesTask, subCategoriesTask);

            categories = categoriesTask.Result ?? new();
            subCategories = subCategoriesTask.Result ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ItemSubCategory] Error: {ex.Message}");
            subCategories = new();
            ShowNotification("Failed to load item sub categories.", isError: true);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private IEnumerable<ItemSubCategoryModel> FilteredSubCategories
    {
        get
        {
            var query = subCategories.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var q = searchQuery.Trim();
                query = query.Where(d =>
                    (d.Code?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (d.Name?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (d.CategoryName?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            if (!string.IsNullOrWhiteSpace(categoryFilter))
            {
                query = query.Where(d => string.Equals(d.CategoryId, categoryFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (statusFilter == "Active")
                query = query.Where(d => d.Active);
            else if (statusFilter == "Inactive")
                query = query.Where(d => !d.Active);

            return sortColumn switch
            {
                "Name" => sortAscending
                    ? query.OrderBy(d => d.Name).ThenBy(d => d.Code)
                    : query.OrderByDescending(d => d.Name).ThenBy(d => d.Code),
                "Category" => sortAscending
                    ? query.OrderBy(d => d.CategoryName).ThenBy(d => d.Code)
                    : query.OrderByDescending(d => d.CategoryName).ThenBy(d => d.Code),
                "Active" => sortAscending
                    ? query.OrderBy(d => d.Active).ThenBy(d => d.Name)
                    : query.OrderByDescending(d => d.Active).ThenBy(d => d.Name),
                _ => sortAscending
                    ? query.OrderBy(d => d.Code)
                    : query.OrderByDescending(d => d.Code)
            };
        }
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else { sortColumn = column; sortAscending = true; }
    }

    private void ClearFilters() { searchQuery = ""; statusFilter = "All"; categoryFilter = ""; }

    private void OpenAddModal()
    {
        isEditing = false;
        formError = "";
        currentModel = new ItemSubCategoryModel { Id = "", Code = "", Name = "", CategoryId = "", Active = true };
        showModal = true;
    }

    private void OpenEditModal(ItemSubCategoryModel item)
    {
        isEditing = true;
        formError = "";
        currentModel = new ItemSubCategoryModel
        {
            Id = item.Id,
            Code = item.Code,
            Name = item.Name,
            CategoryId = item.CategoryId,
            CategoryName = item.CategoryName,
            Active = item.Active,
            Sequence = item.Sequence,
            CreatedDateTime = item.CreatedDateTime
        };
        showModal = true;
    }

    private void CloseModal()
    {
        if (isSaving) return;
        showModal = false;
        formError = "";
    }

    private void ToggleFormActive() => currentModel.Active = !currentModel.Active;

    private async Task ToggleItemActive(ItemSubCategoryModel item)
    {
        item.Active = !item.Active;
        var (success, _) = await ItemSubCategoryService.SaveSubCategoryAsync(item);
        if (success)
            ShowNotification($"'{item.Name}' is now {(item.Active ? "Active" : "Inactive")}.");
        else
        {
            item.Active = !item.Active;
            ShowNotification("Failed to update status.", isError: true);
        }
        StateHasChanged();
    }

    private async Task SaveSubCategory()
    {
        formError = "";

        if (string.IsNullOrWhiteSpace(currentModel.Name))
        {
            formError = "Sub Category Name is required.";
            return;
        }

        var duplicate = subCategories.FirstOrDefault(d =>
            d.Id != currentModel.Id &&
            d.Name.Equals(currentModel.Name.Trim(), StringComparison.OrdinalIgnoreCase) &&
            string.Equals(d.CategoryId, currentModel.CategoryId ?? "", StringComparison.OrdinalIgnoreCase));
        if (duplicate != null)
        {
            formError = $"Sub Category '{currentModel.Name.Trim()}' already exists in this category.";
            return;
        }

        isSaving = true;
        try
        {
            currentModel.Name = currentModel.Name.Trim();

            var (success, message) = await ItemSubCategoryService.SaveSubCategoryAsync(currentModel);
            if (success)
            {
                showModal = false;
                await LoadDataAsync();
                ShowNotification(isEditing ? $"Updated '{currentModel.Name}'." : $"Added '{currentModel.Name}'.");
            }
            else
            {
                formError = string.IsNullOrWhiteSpace(message) ? "Failed to save sub category." : message;
            }
        }
        catch (Exception ex)
        {
            formError = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void RequestDelete(ItemSubCategoryModel item) { itemToDelete = item; showDeleteConfirm = true; }

    private void CancelDelete()
    {
        if (isDeleting) return;
        showDeleteConfirm = false;
        itemToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (itemToDelete == null) return;
        isDeleting = true;
        try
        {
            var (success, message) = await ItemSubCategoryService.DeleteSubCategoryAsync(itemToDelete.Id);
            if (success)
            {
                showDeleteConfirm = false;
                var name = itemToDelete.Name;
                itemToDelete = null;
                await LoadDataAsync();
                ShowNotification($"Deleted '{name}'.");
            }
            else
            {
                ShowNotification(string.IsNullOrWhiteSpace(message) ? "Failed to delete." : message, isError: true);
            }
        }
        catch (Exception ex) { ShowNotification($"Error: {ex.Message}", isError: true); }
        finally { isDeleting = false; StateHasChanged(); }
    }

    private void ShowNotification(string msg, bool isError = false)
    {
        notificationMessage = msg;
        notificationType = isError ? "error" : "success";
        _ = AutoDismissNotification();
    }

    private async Task AutoDismissNotification()
    {
        await Task.Delay(4000);
        notificationMessage = "";
        await InvokeAsync(StateHasChanged);
    }

    private async Task TriggerToggleSidebar()
    {
        if (OnToggleSidebar.HasDelegate)
            await OnToggleSidebar.InvokeAsync();
    }
}
