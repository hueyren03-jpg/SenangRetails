<RetailSetupPageStyle />

@code {
    private List<BarcodeReadingSetupModel> rules = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private string searchQuery = "";
    private string alertMessage = "";
    private bool isSuccess = true;

    private bool showModal = false;
    private bool isEditMode = false;
    private string errorMessage = "";
    private string activeTab = "RulePattern";
    private BarcodeReadingSetupModel currentRule = new();

    private bool showDeleteModal = false;
    private BarcodeReadingSetupModel? ruleToDelete;

    // Keypad State
    private bool showKeypad = false;
    private string keypadTitle = "";
    private string keypadField = "";
    private string keypadValueString = "0";

    protected override async Task OnInitializedAsync()
    {
        await LoadRules();
    }

    private async Task LoadRules()
    {
        isLoading = true;
        try
        {
            rules = await BarcodeService.GetRulesAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<BarcodeReadingSetupModel> FilteredRules
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchQuery)) return rules;
            return rules.Where(r => (r.Prefix ?? "").Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                     (r.BarcodeType ?? "").Contains(searchQuery, StringComparison.OrdinalIgnoreCase));
        }
    }

    private void OpenAddModal()
    {
        isEditMode = false;
        errorMessage = "";
        activeTab = "RulePattern";
        currentRule = new BarcodeReadingSetupModel
        {
            Prefix = GenerateAvailablePrefix(),
            BarcodeType = "BarCode",
            SelectionType = "Barcode",
            ItemCodeLength = 5,
            QuantityLength = 5,
            IsQuantityFixedAsOne = false,
            PriceLength = 5,
            DecimalPlace = 2,
            ChecksumLength = 1,
            BarcodeIncludesPrefix = true,
            HasOverlappingBarcodeItem = false,
            IsActive = true
        };
        showModal = true;
    }

    private string GenerateAvailablePrefix()
    {
        var used = rules.Select(x => x.Prefix).ToHashSet(StringComparer.OrdinalIgnoreCase);
        return Enumerable.Range(20, 80)
            .Select(x => x.ToString("00"))
            .FirstOrDefault(x => !used.Contains(x)) ?? "00";
    }

    private void OpenEditModal(BarcodeReadingSetupModel rule)
    {
        isEditMode = true;
        errorMessage = "";
        activeTab = "RulePattern";
        currentRule = new BarcodeReadingSetupModel
        {
            Prefix = rule.Prefix,
            BarcodeType = rule.BarcodeType,
            SelectionType = rule.SelectionType,
            ItemCodeLength = rule.ItemCodeLength,
            QuantityLength = rule.QuantityLength,
            IsQuantityFixedAsOne = rule.IsQuantityFixedAsOne,
            PriceLength = rule.PriceLength,
            DecimalPlace = rule.DecimalPlace,
            ChecksumLength = rule.ChecksumLength,
            BarcodeIncludesPrefix = rule.BarcodeIncludesPrefix,
            HasOverlappingBarcodeItem = rule.HasOverlappingBarcodeItem,
            IsActive = rule.IsActive
        };
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task SaveRule()
    {
        currentRule.Prefix = currentRule.Prefix?.Trim().ToUpperInvariant() ?? "";
        if (currentRule.Prefix.Length != 2)
        {
            errorMessage = "Prefix must contain exactly 2 characters.";
            return;
        }
        if (!isEditMode && rules.Any(x => x.Prefix.Equals(currentRule.Prefix, StringComparison.OrdinalIgnoreCase)))
        {
            errorMessage = $"Prefix {currentRule.Prefix} already exists.";
            return;
        }
        if (currentRule.ItemCodeLength < 1)
        {
            errorMessage = "Item code length must be at least 1.";
            return;
        }
        if (!currentRule.IsQuantityFixedAsOne && currentRule.QuantityLength < 1)
        {
            errorMessage = "Quantity length must be at least 1, or enable Fixed Quantity As One.";
            return;
        }
        if (currentRule.DecimalPlace is < 0 or > 6)
        {
            errorMessage = "Decimal place must be between 0 and 6.";
            return;
        }

        isSaving = true;
        try
        {
            var success = await BarcodeService.SaveRuleAsync(currentRule, !isEditMode);
            if (success)
            {
                showModal = false;
                alertMessage = "Barcode rule saved successfully!";
                isSuccess = true;
                await LoadRules();
            }
            else
            {
                errorMessage = "Failed to save barcode rule.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ConfirmDelete(BarcodeReadingSetupModel rule)
    {
        ruleToDelete = rule;
        showDeleteModal = true;
    }

    private async Task ExecuteDelete()
    {
        if (ruleToDelete != null)
        {
            await BarcodeService.DeleteRuleAsync(ruleToDelete.Prefix);
            showDeleteModal = false;
            showModal = false;
            ruleToDelete = null;
            alertMessage = "Barcode rule deleted successfully.";
            isSuccess = true;
            await LoadRules();
        }
    }

    // Touch Keypad Methods
    private void OpenKeypad(string field, object currentVal, string title)
    {
        keypadField = field;
        keypadTitle = title;
        keypadValueString = currentVal?.ToString() ?? "0";
        showKeypad = true;
    }

    private void KeypadAppend(string val)
    {
        if (keypadValueString == "0")
            keypadValueString = val;
        else
            keypadValueString += val;
    }

    private void KeypadClear() => keypadValueString = "0";

    private void KeypadBackspace()
    {
        if (keypadValueString.Length > 1)
            keypadValueString = keypadValueString.Substring(0, keypadValueString.Length - 1);
        else
            keypadValueString = "0";
    }

    private void KeypadSave()
    {
        if (int.TryParse(keypadValueString, out var num))
        {
            switch (keypadField)
            {
                case "ItemCodeLength": currentRule.ItemCodeLength = Math.Max(0, num); break;
                case "QuantityLength": currentRule.QuantityLength = Math.Max(0, num); break;
                case "PriceLength": currentRule.PriceLength = Math.Max(0, num); break;
                case "DecimalPlace": currentRule.DecimalPlace = Math.Max(0, num); break;
                case "ChecksumLength": currentRule.ChecksumLength = Math.Max(0, num); break;
            }
        }
        showKeypad = false;
    }

    private void CloseKeypad() => showKeypad = false;
}
