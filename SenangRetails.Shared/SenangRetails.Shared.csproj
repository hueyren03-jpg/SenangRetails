<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\fonts\NotoSansSC-Regular.ttf" Condition="Exists('wwwroot\fonts\NotoSansSC-Regular.ttf')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Blazor.Bootstrap" Version="3.5.0" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="ExcelDataReader" Version="3.8.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.8.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.3" />
    <PackageReference Include="QuestPDF" Version="2023.12.6" />
    <PackageReference Include="ZXingBlazor" Version="1.1.6" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="EBIDM">
      <HintPath>Libraries\EBI\EBIDM.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="EBIEF">
      <HintPath>Libraries\EBI\EBIEF.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="EBIEnum">
      <HintPath>Libraries\EBI\EBIEnum.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="EBIUC">
      <HintPath>Libraries\EBI\EBIUC.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Libraries\EBI\" />
    <Folder Include="wwwroot\lib\fontawesome\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\..\Downloads\EBIDM.dll" Link="Libraries\EBI\EBIDM.dll" />
    <None Include="..\..\..\..\Downloads\EBIEF.dll" Link="Libraries\EBI\EBIEF.dll" />
    <None Include="..\..\..\..\Downloads\EBIEnum.dll" Link="Libraries\EBI\EBIEnum.dll" />
    <None Include="..\..\..\..\Downloads\EBIUC.dll" Link="Libraries\EBI\EBIUC.dll" />
  </ItemGroup>

</Project>
