@inherits SenangRetails.Shared.Pages.BasePage
@using SenangRetails.Shared.Services
@using SenangRetails.Shared.Services.InventoryService
@using SenangRetails.Shared.Models.DTOs
@using EBI.DM
@inject IInventoryService InventoryService
@inject AppState AppState
@inject LocalImageCacheService LocalImageCache

<div class="view-body">
    <div class="header">
        <div class="@(IsInModal ? "modal-close-btn" : "mobile-menu-btn")" @onclick="ToggleNav">
            @if (IsInModal)
            {
                <i class="bi bi-x-lg"></i>
            }
            else
            {
                <i class="bi bi-list"></i>
            }
        </div>
        <div class="header-title">Stock In</div>
        <div class="top-right-button">
            <button type="button" class="stock-action-btn" title="History" @onclick="OpenStockInHistoryAsync">
                <i class="bi bi-clock-history"></i>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(operationMessage))
    {
        <div class="alert @(operationSucceeded ? "alert-success" : "alert-danger")" style="margin: 10px 20px;">
            @operationMessage
        </div>
    }
    
    <div class="stock-in-dropdown-card custom-shadow-sm">
        <span>
            <i class="bi bi-arrows-move"></i> Action
        </span>
        <div @onclick="OpenOrderMain" class="order-button" style="position: relative; z-index: 51;">
            @selectedAction <i class="bi bi-chevron-down"></i>
            @if (orderIsOpenMain)
            {
                <div @onclick="CloseOrderMain" @onclick:stopPropagation="true" class="all-modal-backdrop-no-color"></div>
                <div class="order-option-wrapper-summary">
                    <span @onclick='() => SelectAction("Adjustment")' @onclick:stopPropagation="true">Adjustment</span>
                    <span @onclick='() => SelectAction("Stock In")' @onclick:stopPropagation="true">Stock In</span>
                    <span @onclick='() => SelectAction("Recover")' @onclick:stopPropagation="true">Recover</span>
                </div>
            }
        </div>
    </div>
    
    <div class="stock-in-dropdown-card custom-shadow-sm">
        <textarea placeholder="Remarks" @bind="remarks" />
    </div>

    <div @onclick="OpenAddProductModal" class="stock-in-dropdown-card custom-shadow-sm cursor-pointer mb-15">
        <span><i class="bi bi-box-seam"></i> Add Product</span>
    </div>

    @if (isLoading)
    {
        <div style="display: flex; align-items: center; justify-content: center; padding: 40px;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div class="stock-movement-table custom-shadow-sm">
            <div class="stock-movement-table-row border-bottom">
                <span>Image</span>
                <span>Product</span>
                <span class="text-align-center">Qty</span>
                <span class="text-align-right">Cost</span>
            </div>

            @if (!stockInItems.Any())
            {
                <div style="text-align: center; padding: 40px; color: #888;">
                    <i class="bi bi-box-seam" style="font-size: 2rem; display: block; margin-bottom: 8px; color: #bbb;"></i>
                    No products added yet. Click "Add Product" above to select products.
                </div>
            }
            else
            {
                @foreach (var item in stockInItems)
                {
                    <div class="stock-movement-table-row">
                        <img src="@GetImageUrl(item)" class="stock-in-image" alt="@item.Name" />

                        <div class="stock-in-details">
                            <span class="stock-in-title">@item.Name</span>
                            <span class="stock-in-subtitle">RM @item.PurchasePrice.ToString("N2") | Stock: @item.CurrentStock.ToString("N0")</span>
                        </div>

                        <div class="text-align-center" style="display: inline-flex; align-items: center; justify-content: center; gap: 6px;">
                            <button class="btn btn-sm btn-light" style="padding: 2px 8px; border-radius: 4px; border: 1px solid #ccc;" @onclick="() => DecrementQty(item)">-</button>
                            <span class="number-button compact-number-btn" style="min-width: 36px; text-align: center; display: inline-block;" @onclick='() => OpenCalculator(item, "Quantity")'>@item.StockInQuantity</span>
                            <button class="btn btn-sm btn-light" style="padding: 2px 8px; border-radius: 4px; border: 1px solid #ccc;" @onclick="() => IncrementQty(item)">+</button>
                        </div>

                        <div class="text-align-right">
                            <span class="number-button compact-number-btn" @onclick='() => OpenCalculator(item, "Price")'>@item.StockInCost.ToString("N2")</span>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="delivery-order-total custom-shadow-sm summary-card-container">
            <div class="side-by-side summary-line">
                <span class="summary-text">Total SKU</span>
                <span class="summary-value">@TotalSku</span>
            </div>
            <div class="side-by-side summary-line">
                <span class="summary-text">Total Quantity</span>
                <span class="summary-value">@TotalQuantity</span>
            </div>
            <div class="side-by-side summary-total-line">
                <span class="summary-total-text">Total Cost</span>
                <span class="summary-total-value">RM @TotalCost.ToString("N2")</span>
            </div>

            <button class="confirm-btn w-100" @onclick="ConfirmStockIn">
                Confirm Stock In
            </button>
        </div>
    }

    @if (stockInHistoryIsOpen)
    {
        <div class="stock-history-overlay">
            <div class="header stock-history-header">
                <button type="button" class="header-back-btn" @onclick="CloseStockInHistory">
                    <i class="bi bi-chevron-left"></i>
                    <span>Back</span>
                </button>
                <div class="header-title">Stock In History</div>
                <button type="button" class="stock-action-btn" @onclick="RefreshStockInHistoryAsync">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>

            <div class="stock-history-content">
                @if (isLoadingHistory)
                {
                    <div style="text-align:center; padding:40px;">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>
                }
                else if (selectedStockInRecord != null)
                {
                    <div class="summary-card-container custom-shadow-sm" style="margin-bottom:15px;">
                        <div class="side-by-side summary-line">
                            <span class="summary-text">GRN</span>
                            <span class="summary-value">@(string.IsNullOrWhiteSpace(selectedStockInRecord.mobjDoc_Stock_GRN.DisplayCode) ? selectedStockInRecord.mobjDoc_Stock_GRN.DocumentID : selectedStockInRecord.mobjDoc_Stock_GRN.DisplayCode)</span>
                        </div>
                        <div class="side-by-side summary-line">
                            <span class="summary-text">Date</span>
                            <span class="summary-value">@selectedStockInRecord.mobjDoc_Stock_GRN.FinancialDate.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="side-by-side summary-line">
                            <span class="summary-text">Activity</span>
                            <span class="summary-value">@(string.IsNullOrWhiteSpace(selectedStockInRecord.mobjDoc_Stock_GRN.StockActivityType) ? "Stock In" : selectedStockInRecord.mobjDoc_Stock_GRN.StockActivityType)</span>
                        </div>
                        <div class="side-by-side summary-line">
                            <span class="summary-text">Remarks</span>
                            <span class="summary-value">@(string.IsNullOrWhiteSpace(selectedStockInRecord.mobjDoc_Stock_GRN.Remarks) ? "—" : selectedStockInRecord.mobjDoc_Stock_GRN.Remarks)</span>
                        </div>
                    </div>

                    <button type="button" class="history-back-list-btn" @onclick="BackToStockInHistoryList">
                        Back to History
                    </button>

                    <div class="stock-movement-table custom-shadow-sm">
                        <div class="history-table-row border-bottom">
                            <span>Product</span>
                            <span class="text-align-center">Qty</span>
                            <span class="text-align-right">Cost</span>
                            <span class="text-align-right">Total</span>
                        </div>
                        @foreach (var line in selectedStockInRecord.lstDocumentLine ?? [])
                        {
                            <div class="history-table-row">
                                <span>@(!string.IsNullOrWhiteSpace(line.Description) ? line.Description : line.ItemName)</span>
                                <span class="text-align-center">@line.Quantity</span>
                                <span class="text-align-right">@line.UnitPrice.ToString("N2")</span>
                                <span class="text-align-right">@((line.Quantity * line.UnitPrice).ToString("N2"))</span>
                            </div>
                        }
                    </div>
                }
                else if (!stockInHistory.Any())
                {
                    <div style="text-align:center; padding:40px; color:#888;">
                        <i class="bi bi-clock-history" style="font-size:2rem;"></i>
                        <div>No stock in history found.</div>
                    </div>
                }
                else
                {
                    <div class="stock-movement-table custom-shadow-sm">
                        <div class="history-table-row border-bottom">
                            <span>GRN</span>
                            <span>Activity</span>
                            <span class="text-align-center">Date</span>
                            <span class="text-align-right">Total</span>
                        </div>
                        @foreach (var record in stockInHistory)
                        {
                            <div class="history-table-row cursor-pointer" @onclick="() => OpenStockInHistoryRecordAsync(record)">
                                <span>@(string.IsNullOrWhiteSpace(record.DisplayCode) ? record.DocumentID : record.DisplayCode)</span>
                                <span>@(string.IsNullOrWhiteSpace(record.StockActivityType) ? "Stock In" : record.StockActivityType)</span>
                                <span class="text-align-center">@record.FinancialDate.ToString("dd/MM/yyyy")</span>
                                <span class="text-align-right">@record.TotalAfterTax.ToString("N2")</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <Calculator IsOpen="@isLocalCalculatorOpen"
                Title="@calculatorType"
                AllowDecimal="@(calculatorType == "Price")"
                InitialValue="@calculatorInitialValue"
                OnSave="HandleCalculatorSave"
                OnClose="CloseLocalCalculator" />
</div>

@code {
    [Parameter] public EventCallback OnToggleNav { get; set; }
    [Parameter] public bool IsInModal { get; set; } = false;

    // Remaining parameters kept for backwards-compatibility or integration
    [Parameter] public int Quantity { get; set; } = 10;
    [Parameter] public double Price { get; set; } = 5;

    [Parameter] public EventCallback OnOpenAddProduct { get; set; }
    [Parameter] public EventCallback OnEditQuantity { get; set; }
    [Parameter] public EventCallback OnEditPrice { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    public class StockInItemDisplay
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public decimal CurrentStock { get; set; }
        public string Unit { get; set; } = "Unit";
        public decimal PurchasePrice { get; set; }
        public string? ImagePath { get; set; }
        public string? ImageFileName { get; set; }

        public decimal StockInQuantity { get; set; }
        public decimal StockInCost { get; set; }
    }

    private List<StockInItemDisplay> allAvailableItems = new();
    private List<StockInItemDisplay> stockInItems = new();
    private string selectedAction = "Stock In";
    private bool orderIsOpenMain = false;
    private bool isLoading = true;
    private string remarks = "";
    private List<InventoryDM> allItemsList = new();
    private bool IsSuccessCreating;
    private bool stockInHistoryIsOpen;
    private bool isLoadingHistory;
    private List<Doc_Stock_GRNDM> stockInHistory = new();
    private EBI.UC.Doc_Stock_GRN? selectedStockInRecord;
    private string operationMessage = "";
    private bool operationSucceeded;

    private StockInItemDisplay? editingItem;
    private string calculatorType = "";
    private bool isLocalCalculatorOpen = false;
    private double calculatorInitialValue = 0;

    // Dynamic calculations
    private int TotalSku => stockInItems.Count(i => i.StockInQuantity > 0);
    private decimal TotalQuantity => stockInItems.Sum(i => i.StockInQuantity);
    private decimal TotalCost => stockInItems.Where(i => i.StockInQuantity > 0).Sum(i => (decimal)i.StockInQuantity * i.StockInCost);

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    public void AddProductToStockIn(string masterAccountId)
    {
        var existing = stockInItems.FirstOrDefault(i => i.Id == masterAccountId);
        if (existing != null)
        {
            existing.StockInQuantity++;
        }
        else
        {
            var matched = allAvailableItems.FirstOrDefault(i => i.Id == masterAccountId);
            if (matched != null)
            {
                stockInItems.Add(new StockInItemDisplay
                {
                    Id = matched.Id,
                    Name = matched.Name,
                    CurrentStock = matched.CurrentStock,
                    Unit = matched.Unit,
                    PurchasePrice = matched.PurchasePrice,
                    ImagePath = matched.ImagePath,
                    ImageFileName = matched.ImageFileName,
                    StockInQuantity = 1,
                    StockInCost = matched.PurchasePrice
                });
            }
        }
        StateHasChanged();
    }

    private async Task OpenAddProductModal()
    {
        await OnOpenAddProduct.InvokeAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            var branchId = AppState.SelectedBranchID;

            // Load master items
            allItemsList = await InventoryService.LoadItemsAsync(branchId) ?? new List<InventoryDM>();
            var productItems = allItemsList.Where(i => i.InventoryTypeID == 1).ToList();

            if (productItems.Any())
            {
                // Load stock balances
                var req = new StockBalanceRequest
                {
                    BranchID = branchId,
                    InventoryIDs = string.Join(",", productItems.Select(p => p.MasterAccountID)),
                    FinancialDate = DateTime.Today,
                    EndDate = DateTime.Today,
                    RedemptionEndDate = DateTime.Today,
                    NewExpiryDate = DateTime.Today
                };

                var balances = await InventoryService.GetStockBalanceByBranchAndByItemAsync(req)
                              ?? new Dictionary<string, StockBalanceItem>();

                allAvailableItems.Clear();
                foreach (var pi in productItems)
                {
                    decimal currentQty = 0;
                    if (balances.TryGetValue(pi.MasterAccountID ?? string.Empty, out var balItem))
                    {
                        currentQty = balItem.ExistingQuantity;
                    }

                    allAvailableItems.Add(new StockInItemDisplay
                    {
                        Id = pi.MasterAccountID ?? string.Empty,
                        Name = pi.AccountName ?? string.Empty,
                        CurrentStock = currentQty,
                        Unit = pi.UnitOfMeasureName ?? pi.UnitOfMeasureID ?? "Unit",
                        PurchasePrice = pi.PurchasePrice,
                        ImagePath = pi.ImagePath,
                        ImageFileName = pi.ImageFileName,
                        StockInQuantity = 0,
                        StockInCost = pi.PurchasePrice
                    });
                }
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[InventoryStockIn] Error loading data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetImageUrl(StockInItemDisplay item)
    {
        var cached = LocalImageCache.GetImage(item.Id);
        if (!string.IsNullOrEmpty(cached)) return cached;
        if (!string.IsNullOrEmpty(item.ImagePath))
        {
            return item.ImagePath;
        }
        return "https://placehold.co/400";
    }

    private void IncrementQty(StockInItemDisplay item)
    {
        item.StockInQuantity++;
    }

    private void DecrementQty(StockInItemDisplay item)
    {
        if (item.StockInQuantity > 1)
        {
            item.StockInQuantity--;
        }
        else
        {
            stockInItems.Remove(item);
        }
    }

    private void OpenCalculator(StockInItemDisplay item, string type)
    {
        editingItem = item;
        calculatorType = type;
        calculatorInitialValue = type == "Quantity" ? (double)item.StockInQuantity : (double)item.StockInCost;
        isLocalCalculatorOpen = true;
    }

    private void CloseLocalCalculator()
    {
        isLocalCalculatorOpen = false;
        editingItem = null;
    }

    private void HandleCalculatorSave(double value)
    {
        if (editingItem != null)
        {
            if (calculatorType == "Quantity")
            {
                editingItem.StockInQuantity = (int)value;
                if (editingItem.StockInQuantity < 1)
                {
                    stockInItems.Remove(editingItem);
                }
            }
            else if (calculatorType == "Price")
            {
                editingItem.StockInCost = (decimal)value;
            }
        }
        isLocalCalculatorOpen = false;
        editingItem = null;
    }

    private void ToggleNav()
    {
        OnToggleNav.InvokeAsync();
    }

    private void OpenOrderMain()
    {
        orderIsOpenMain = true;
    }

    private void CloseOrderMain()
    {
        orderIsOpenMain = false;
    }

    private void SelectAction(string action)
    {
        selectedAction = action;
        orderIsOpenMain = false;
    }


    private string ResolveBranchId() =>
        string.IsNullOrWhiteSpace(AppState.SelectedBranchID)
            ? AppState.CurrentBranch?.BranchID ?? ""
            : AppState.SelectedBranchID;

    private async Task OpenStockInHistoryAsync()
    {
        stockInHistoryIsOpen = true;
        selectedStockInRecord = null;
        await RefreshStockInHistoryAsync();
    }

    private void CloseStockInHistory()
    {
        stockInHistoryIsOpen = false;
        selectedStockInRecord = null;
    }

    private void BackToStockInHistoryList()
    {
        selectedStockInRecord = null;
    }

    private async Task RefreshStockInHistoryAsync()
    {
        isLoadingHistory = true;
        try
        {
            var branchId = ResolveBranchId();
            if (string.IsNullOrWhiteSpace(branchId))
            {
                stockInHistory = new();
                return;
            }

            stockInHistory = (await InventoryService.GetStockGRNRecordsAsync(
                branchId,
                DateTime.Today.AddYears(-1),
                DateTime.Today.AddDays(1).AddTicks(-1),
                1,
                500) ?? new List<Doc_Stock_GRNDM>())
                .Where(record => record != null && !record.IsVoid)
                .OrderByDescending(record => record.FinancialDate)
                .ToList();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[InventoryStockIn] Error loading GRN history: {ex.Message}");
            operationSucceeded = false;
            operationMessage = "Unable to load stock in history.";
        }
        finally
        {
            isLoadingHistory = false;
        }
    }

    private async Task OpenStockInHistoryRecordAsync(Doc_Stock_GRNDM record)
    {
        if (string.IsNullOrWhiteSpace(record.DocumentID))
            return;

        isLoadingHistory = true;
        try
        {
            selectedStockInRecord = await InventoryService.GetStockGRNRecordAsync(record.DocumentID);
            if (selectedStockInRecord == null)
            {
                operationSucceeded = false;
                operationMessage = "Unable to load this stock in record.";
            }
        }
        finally
        {
            isLoadingHistory = false;
        }
    }

    private async Task ConfirmStockIn()
    {
        operationMessage = "";
        operationSucceeded = false;

        var activeItems = stockInItems.Where(i => i.StockInQuantity > 0).ToList();
        if (!activeItems.Any())
        {
            operationMessage = "Add at least one product before confirming stock in.";
            return;
        }

        var branchId = ResolveBranchId();
        if (string.IsNullOrWhiteSpace(branchId))
        {
            operationMessage = "A branch is required before confirming stock in.";
            return;
        }

        var now = DateTime.Now;
        var request = new EBI.UC.Doc_Stock_GRN();
        var header = request.mobjDoc_Stock_GRN;
        var total = activeItems.Sum(i => i.StockInQuantity * i.StockInCost);

        header.DocumentTypeID = (int)EBI.Enum.EnumDocumentType.GRN;
        header.BranchID = branchId;
        header.EditBranchID = branchId;
        header.FinancialDate = now;
        header.PostingDate = now;
        header.IsPostingDateDifferent = false;
        header.Remarks = remarks;
        header.StockActivityType = selectedAction;
        header.GroupID = AppState.SelectedBranchGroupID;
        header.TotalBeforeTax = total;
        header.TotalAfterTax = total;
        header.SaveAction = EBI.Enum.EntityState.Added;
        header.IsDirty = true;

        foreach (var item in activeItems)
        {
            var masterInventoryItem = allItemsList.FirstOrDefault(i => i.MasterAccountID == item.Id);
            var lineTotal = item.StockInQuantity * item.StockInCost;

            var lineItem = new DocumentLineTableDM
            {
                OwnerDocumentTypeID = (int)EBI.Enum.EnumDocumentType.GRN,
                Description = masterInventoryItem?.AccountName ?? item.Name,
                ItemName = masterInventoryItem?.AccountName ?? item.Name,
                InventoryTypeID = masterInventoryItem?.InventoryTypeID ?? 1,
                InventoryItemAccountID = masterInventoryItem?.MasterAccountID ?? item.Id,
                LineItemID = masterInventoryItem?.MasterAccountID ?? item.Id,
                Quantity = item.StockInQuantity,
                UnitPrice = item.StockInCost,
                Cost = item.StockInCost,
                SubTotal = lineTotal,
                SubTotalBeforeGST = lineTotal,
                UnitOfMeasurementID = masterInventoryItem?.UnitOfMeasureID ?? "",
                SKUQuantity = masterInventoryItem?.UOMBase is > 0 ? masterInventoryItem.UOMBase : 1,
                BranchID = branchId,
                EditBranchID = branchId,
                GroupID = AppState.SelectedBranchGroupID,
                FinancialDate = now,
                SaveAction = EBI.Enum.EntityState.Added,
                IsDirty = true
            };

            request.lstDocumentLine.Add(lineItem);
        }

        try
        {
            var jsonOptions = new System.Text.Json.JsonSerializerOptions { WriteIndented = true };
            var requestJson = System.Text.Json.JsonSerializer.Serialize(request, jsonOptions);
            System.Diagnostics.Debug.WriteLine($"[ConfirmStockIn] GRN Stock In Request Body:\n{requestJson}");

            IsSuccessCreating = await InventoryService.CreateStockInGRN(request);
            if (!IsSuccessCreating)
            {
                operationMessage = "Failed to create stock in record.";
                return;
            }

            operationSucceeded = true;
            operationMessage = "Stock in created successfully.";
            stockInItems.Clear();
            remarks = "";

            if (OnConfirm.HasDelegate)
                await OnConfirm.InvokeAsync();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[InventoryStockIn] Create GRN failed: {ex.Message}");
            operationMessage = $"Failed to create stock in: {ex.Message}";
        }
    }
}
