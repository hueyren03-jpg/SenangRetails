@page "/goods-issue-note"
@inherits SenangRetails.Shared.Pages.BasePage

<div class="gin-page @(isEditorOpen ? "gin-page--editor-open" : string.Empty)">
    @if (!isEditorOpen)
    {
        <main class="gin-list-view">
            <header class="gin-header">
                <div class="gin-header__left">
                    <button type="button" class="gin-menu-button" @onclick="ToggleNav" title="Inventory menu" aria-label="Inventory menu">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <button type="button" class="gin-back-button" @onclick="HandleBack">
                        <i class="fa-solid fa-chevron-left"></i>
                        <span>Back</span>
                    </button>
                </div>
                <div class="gin-header__title">Goods Issue Note</div>
                <div class="gin-header__right">
                    <button type="button" class="gin-new-button" @onclick="OpenNewDocument">
                        <i class="fa-solid fa-plus"></i>
                        <span>New GIN</span>
                    </button>
                </div>
            </header>

            <section class="gin-summary" aria-label="GIN summary">
                <div class="gin-summary__card">
                    <span>Total notes</span>
                    <strong>@FilteredDocuments.Count()</strong>
                </div>
                <div class="gin-summary__card">
                    <span>Total quantity</span>
                    <strong>@FilteredDocuments.Sum(item => item.TotalQuantity).ToString("N0") Units</strong>
                </div>
                <div class="gin-summary__card">
                    <span>Total value</span>
                    <strong>RM @FilteredDocuments.Sum(item => item.TotalValue).ToString("N2")</strong>
                </div>
            </section>

            <section class="gin-toolbar" aria-label="Document filters">
                <label class="gin-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="search"
                           placeholder="Search goods issue notes..."
                           aria-label="Search goods issue notes"
                           @bind="searchText"
                           @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(searchText))
                    {
                        <button type="button" @onclick="ClearSearch" title="Clear search" aria-label="Clear search">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    }
                </label>

                <label class="gin-filter">
                    <i class="fa-solid fa-filter"></i>
                    <select @bind="statusFilter" aria-label="Status">
                        <option value="All">All status</option>
                        <option value="Posted">Posted</option>
                        <option value="Void">Void</option>
                    </select>
                </label>

                <label class="gin-filter gin-filter--date">
                    <i class="fa-regular fa-calendar"></i>
                    <input type="date" @bind="filterFrom" aria-label="From date" />
                </label>

                <label class="gin-filter gin-filter--date">
                    <i class="fa-solid fa-arrow-right"></i>
                    <input type="date" @bind="filterTo" aria-label="To date" />
                </label>

                <button type="button" class="gin-refresh-button" @onclick="RefreshList" title="Refresh" aria-label="Refresh">
                    <i class="fa-solid fa-rotate-right"></i>
                </button>
            </section>

            <section class="gin-document-table" aria-label="Goods issue notes">
                <div class="gin-document-table__head">
                    <span>GIN number</span>
                    <span>Activity</span>
                    <span class="gin-align-right">Total</span>
                </div>

                @if (!FilteredDocuments.Any())
                {
                    <div class="gin-empty-state">
                        <i class="fa-regular fa-file-lines"></i>
                        <span>No goods issue notes found</span>
                    </div>
                }
                else
                {
                    @foreach (var document in FilteredDocuments)
                    {
                        <button type="button" class="gin-document-row" @onclick="() => OpenDocument(document)">
                            <span class="gin-document-cell">
                                <strong>@document.DocumentNumber</strong>
                                <small>@document.FinancialDate.ToString("dd/MM/yyyy")</small>
                            </span>
                            <span class="gin-document-cell">
                                <strong>@document.Activity</strong>
                                <small>@(string.IsNullOrWhiteSpace(document.ReferenceNumber) ? "No reference" : document.ReferenceNumber)</small>
                            </span>
                            <span class="gin-document-cell gin-document-cell--total">
                                <strong>RM @document.TotalValue.ToString("N2")</strong>
                                <small>@document.ItemCount item(s) · @document.Status</small>
                            </span>
                        </button>
                    }
                }
            </section>
        </main>
    }
    else
    {
        <main class="gin-editor" role="dialog" aria-modal="true" aria-label="Goods issue note editor">
            <header class="gin-header gin-editor-header">
                <div class="gin-header__left">
                    <button type="button" class="gin-close-button" @onclick="CloseEditor" title="Close" aria-label="Close">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
                <div class="gin-header__title">@(isEditingExisting ? "Edit Goods Issue Note" : "Create Goods Issue Note")</div>
                <div class="gin-header__right">
                    <span class="gin-editor-status gin-editor-status--@draft.Status.ToString().ToLowerInvariant()">@draft.Status</span>
                </div>
            </header>

            <div class="gin-editor-scroll">
                @if (!string.IsNullOrWhiteSpace(messageText))
                {
                    <div class="gin-message gin-message--@messageType" role="status">
                        <i class="fa-solid @(messageType == "error" ? "fa-circle-exclamation" : "fa-circle-check")"></i>
                        <span>@messageText</span>
                        <button type="button" @onclick="DismissMessage" title="Dismiss" aria-label="Dismiss message"><i class="fa-solid fa-xmark"></i></button>
                    </div>
                }

                <section class="gin-form-card" aria-label="Document details">
                    <label class="gin-form-row gin-form-row--readonly">
                        <span class="gin-form-row__label"><i class="fa-solid fa-store"></i> Branch</span>
                        <span class="gin-form-row__control">@draft.BranchId</span>
                    </label>

                    <div class="gin-form-row gin-dropdown-row">
                        <span class="gin-form-row__label"><i class="fa-solid fa-list-check"></i> Activity</span>
                        <div class="gin-form-row__control">
                            <button type="button"
                                    class="gin-field-select"
                                    aria-label="Activity"
                                    aria-haspopup="listbox"
                                    aria-expanded="@activityMenuOpen"
                                    @onclick="ToggleActivityMenu">
                                <span>@draft.Activity</span>
                                <i class="fa-solid fa-chevron-down @(activityMenuOpen ? "gin-chevron-open" : string.Empty)"></i>
                            </button>

                            @if (activityMenuOpen)
                            {
                                <button type="button"
                                        class="gin-dropdown-backdrop"
                                        aria-label="Close activity selection"
                                        @onclick="CloseActivityMenu"></button>
                                <div class="gin-field-menu" role="listbox" aria-label="Activity options">
                            @foreach (var activity in activityOptions)
                            {
                                        <button type="button"
                                                class="gin-field-menu__option @(draft.Activity == activity ? "active" : string.Empty)"
                                                role="option"
                                                aria-selected="@(draft.Activity == activity)"
                                                @onclick="() => SelectActivity(activity)">
                                            <span>@activity</span>
                                            @if (draft.Activity == activity)
                                            {
                                                <i class="fa-solid fa-check"></i>
                                            }
                                        </button>
                            }
                                </div>
                            }
                        </div>
                    </div>

                    <label class="gin-form-row">
                        <span class="gin-form-row__label"><i class="fa-regular fa-calendar"></i> Financial date</span>
                        <span class="gin-form-row__control"><input type="date" @bind="draft.FinancialDate" aria-label="Financial date" /></span>
                    </label>

                    <label class="gin-form-row">
                        <span class="gin-form-row__label"><i class="fa-regular fa-calendar-check"></i> Posting date</span>
                        <span class="gin-form-row__control"><input type="date" @bind="draft.PostingDate" aria-label="Posting date" /></span>
                    </label>

                    <label class="gin-form-row">
                        <span class="gin-form-row__label"><i class="fa-regular fa-file-lines"></i> Reference</span>
                        <span class="gin-form-row__control"><input type="text" placeholder="Optional" @bind="draft.ReferenceNumber" aria-label="Reference" /></span>
                    </label>

                    <label class="gin-form-row">
                        <span class="gin-form-row__label"><i class="fa-regular fa-user"></i> Issue to</span>
                        <span class="gin-form-row__control"><input type="text" placeholder="Department or staff" @bind="draft.AccountName" aria-label="Issue to" /></span>
                    </label>

                    <label class="gin-form-row gin-form-row--remarks">
                        <span class="gin-form-row__label"><i class="fa-regular fa-note-sticky"></i> Remarks</span>
                        <span class="gin-form-row__control"><textarea rows="2" placeholder="Optional note" @bind="draft.Remarks" aria-label="Remarks"></textarea></span>
                    </label>
                </section>

                <button type="button" class="gin-add-product-card" @onclick="OpenItemPicker">
                    <span><i class="fa-solid fa-box"></i> Add Product</span>
                    <i class="fa-solid fa-chevron-right"></i>
                </button>

                @if (draft.Lines.Any())
                {
                    <section class="gin-lines-table" aria-label="Issued products">
                        <div class="gin-lines-table__head">
                            <span>Product</span>
                            <span class="gin-align-center">UOM</span>
                            <span class="gin-align-center">Quantity</span>
                            <span class="gin-align-right">Cost</span>
                            <span class="gin-align-right">Total</span>
                            <span class="gin-align-center">Action</span>
                        </div>

                        @foreach (var line in draft.Lines)
                        {
                            <div class="gin-line-row">
                                <div class="gin-line-row__item">
                                    <strong>@line.ItemName</strong>
                                    <small>@line.ItemCode</small>
                                </div>
                                <div class="gin-line-row__uom gin-align-center" data-label="UOM">@line.Uom</div>
                                <div class="gin-quantity" data-label="Quantity">
                                    <button type="button" @onclick="() => ChangeQuantity(line, -1)" title="Decrease quantity" aria-label="Decrease quantity"><i class="fa-solid fa-minus"></i></button>
                                    <input type="number" min="0.01" step="1" @bind="line.Quantity" aria-label="Issue quantity for @line.ItemName" />
                                    <button type="button" @onclick="() => ChangeQuantity(line, 1)" title="Increase quantity" aria-label="Increase quantity"><i class="fa-solid fa-plus"></i></button>
                                </div>
                                <label class="gin-cost-input" data-label="Cost">
                                    <span>RM</span>
                                    <input type="number" min="0" step="0.01" @bind="line.Cost" aria-label="Unit cost for @line.ItemName" />
                                </label>
                                <div class="gin-line-row__value gin-align-right" data-label="Total">RM @line.Total.ToString("N2")</div>
                                <div class="gin-align-center">
                                    <button type="button" class="gin-remove-line" @onclick="() => RemoveLine(line)" title="Remove item" aria-label="Remove @line.ItemName">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </section>
                }
                else
                {
                    <div class="gin-empty-products">
                        <i class="fa-solid fa-box-open"></i>
                        <span>No products added</span>
                    </div>
                }

                <section class="gin-document-total" aria-label="Document totals">
                    <span>@draft.Lines.Count item(s)</span>
                    <span>@draft.Lines.Sum(line => line.Quantity).ToString("N2") units</span>
                    <strong>RM @draft.TotalValue.ToString("N2")</strong>
                </section>
            </div>

            <footer class="gin-bottom-action-bar">
                <button type="button" class="gin-secondary-button" @onclick="SaveDraft" disabled="@isSaving">
                    <i class="fa-regular fa-floppy-disk"></i>
                    Save
                </button>
                <button type="button" class="gin-primary-button" @onclick="PostDocument" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <i class="fa-solid fa-circle-notch fa-spin"></i>
                    }
                    else
                    {
                        <i class="fa-solid fa-check"></i>
                    }
                    @(isEditingExisting ? "Update & Close" : "Create & Close")
                </button>
            </footer>
        </main>
    }

    <InventoryAddProductModal IsOpen="@showItemPicker"
                              Title="Add Product"
                              OnClose="CloseItemPicker"
                              OnProductSelected="HandleProductSelected" />
</div>
